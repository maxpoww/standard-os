{
  "exclusive": true,
  "spacing": 4,
  "modules-left": [
    "group/workspaces",
    "group/active-window"
  ],
  "modules-center": [
    "group/group-rofi",
    "custom/window",
    "custom/x"
  ],
  "modules-right": [
    "tray",
    "group/group-2",
    "group/group-power",
    "custom/clock",
    "custom/battery",
    "custom/night-dimmer",
    "group/screen-type-group",
    "custom/dictate"
  ],
  "tray": {
    "icon-size": 21,
    "spacing": 10,
    "show-passive-items": true,
    "reverse-direction": false
  },
  "group/active-window": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 200,
      "transition-left-to-right": true
    },
    "modules": [
      "hyprland/window",
      "custom/win-close",
      "custom/win-minimize",
      "custom/win-swap-right",
      "group/win-move"
    ]
  },
  "hyprland/window": {
    "format": "",
    "icon": true,
    "icon-size": 22,
    "on-click": "~/.config/waybar/scripts/win-action.sh new-instance"
  },
  "custom/win-close": {
    "exec": "cat /tmp/waybar-cache/win-close 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch killactive"
  },
  "custom/win-minimize": {
    "exec": "cat /tmp/waybar-cache/win-minimize 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspacesilent special"
  },
  "custom/win-swap-right": {
    "exec": "cat /tmp/waybar-cache/win-swap-right 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "/home/max/.config/waybar/scripts/swap-smart.sh"
  },
  "group/win-move": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 200,
      "transition-left-to-right": true
    },
    "modules": [
      "custom/win-move-trigger",
      "custom/win-move-1",
      "custom/win-move-2",
      "custom/win-move-3",
      "custom/win-move-4",
      "custom/win-move-5",
      "custom/win-move-6",
      "custom/win-move-7",
      "custom/win-move-8",
      "custom/win-move-9",
      "custom/win-move-new"
    ]
  },
  "custom/win-move-trigger": {
    "exec": "cat /tmp/waybar-cache/win-move-trigger 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false
  },
  "custom/win-move-1": {
    "exec": "cat /tmp/waybar-cache/win-move-1 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace 1"
  },
  "custom/win-move-2": {
    "exec": "cat /tmp/waybar-cache/win-move-2 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace 2"
  },
  "custom/win-move-3": {
    "exec": "cat /tmp/waybar-cache/win-move-3 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace 3"
  },
  "custom/win-move-4": {
    "exec": "cat /tmp/waybar-cache/win-move-4 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace 4"
  },
  "custom/win-move-5": {
    "exec": "cat /tmp/waybar-cache/win-move-5 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace 5"
  },
  "custom/win-move-6": {
    "exec": "cat /tmp/waybar-cache/win-move-6 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace 6"
  },
  "custom/win-move-7": {
    "exec": "cat /tmp/waybar-cache/win-move-7 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace 7"
  },
  "custom/win-move-8": {
    "exec": "cat /tmp/waybar-cache/win-move-8 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace 8"
  },
  "custom/win-move-9": {
    "exec": "cat /tmp/waybar-cache/win-move-9 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace 9"
  },
  "custom/win-move-new": {
    "exec": "cat /tmp/waybar-cache/win-move-new 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace empty"
  },
  "group/screen-type-group": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 100,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/warm-cycle",
      "custom/shader-paper",
      "custom/shader-newspaper"
    ]
  },
  "custom/warm-cycle": {
    "exec": "~/.config/waybar/scripts/warm-cycle.sh exec",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/warm-cycle.sh click"
  },
  "custom/shader-paper": {
    "exec": "~/.config/waybar/scripts/shader-toggle.sh exec paper",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/shader-toggle.sh click paper"
  },
  "custom/shader-newspaper": {
    "exec": "~/.config/waybar/scripts/shader-toggle.sh exec newspaper",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/shader-toggle.sh click newspaper"
  },
  "custom/night-dimmer": {
    "exec": "~/.config/waybar/scripts/night-dimmer.sh exec",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/night-dimmer.sh click"
  },
  "custom/dictate": {
    "exec": "dictate-waybar",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 11,
    "tooltip": true
  },
  "group/group-rofi": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 200,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/new",
      "custom/hidden"
    ]
  },
  "custom/new": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"\",\"class\":\"%s\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": false,
    "on-click": "rofi -show drun"
  },
  "custom/hidden": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"\",\"class\":\"%s\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": false,
    "on-click": "swaylock"
  },
  "custom/x": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"󱂬\",\"class\":\"%s\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/restore-minimized.sh"
  },
  "group/group-2": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 100,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/tools",
      "group/group-blue",
      "group/group-wifi"
    ]
  },
  "group/group-blue": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 100,
      "transition-left-to-right": true
    },
    "modules": [
      "custom/blue",
      "custom/kill",
      "custom/scan",
      "custom/more"
    ]
  },
