/*
 * options-base.rasi — shared shape and surface rules for every rofi
 * surface in OPTIONS. The light and dark theme files @import this and
 * set @opt-surface-parent / @opt-surface-child / @opt-text constants.
 *
 * Soul rule: rofi IS a fragment of the bar dropped down — bar-veil
 * window with pills inside, mirroring window#waybar's structure.
 * - Window: bar-veil surface, rounded, NO hard border (Rule 3).
 * - Notif rows (records): parent surface (mirrors .opt-pill at rest).
 * - Action rows (verbs): child surface (mirrors .opt-pill-child).
 * - Selected row: white film 0.30 alpha (universal bright-hover).
 * - Section headers: smaller font, dim, no pill surface.
 *
 * Color tokens are defined in options-dark.rasi / options-light.rasi
 * and mirror the @define-color block in waybar/style.css exactly:
 *   opt-surface-parent  rgba(128, 128, 128, 0.30)  — universal neutral glass
 *   opt-surface-child   rgba(170, 170, 170, 0.30)  — universal brighter glass
 *   opt-hover-bright    rgba(255, 255, 255, 0.30)  — universal white film
 *   opt-text            rgba(255, 255, 255, 1.00)  — dark: opt-text-on-dark
 *                       rgba(  0,   0,   0, 0.85)  — light: opt-text-on-light
 *   opt-text-dim        dark: 55% alpha white / light: 55% alpha black
 */

configuration {
    /* Font: copy-verbatim from waybar/style.css:188-191. Same family
       fallback chain (MesloLGS NF primary for full Nerd Font glyph set,
       then Font Awesome 7 Free, Symbols Nerd Font Mono, then monospace).
       Size is 13px EXPLICITLY — without the px suffix Pango treats the
       number as POINTS and renders 13pt ≈ 17px, ~30% larger than the
       bar's 13px text. Pango ≥ 1.44 honors the px suffix. */
    font: "MesloLGS NF, Font Awesome 7 Free, Symbols Nerd Font Mono 13px";
    /* show-icons: false — notif-menu and the other current rofi callers
       emit text-only rows. With show-icons: true rofi reserves a 1.6em
       slot for an icon container per row even when no icon path is
       provided, leaving a blank gap to the left of every text cell. */
    show-icons: false;
    me-select-entry: "MouseSecondary";
    me-accept-entry: "MousePrimary";
    hover-select: true;
    click-to-exit: true;
}

* {
    background-color: transparent;
    text-color:       @opt-text;
    border:           0px;            /* Rule 3: no hard borders */
}

/* Window — the bar-veil container. Position is overridden by the
   launcher's -theme-str (x-offset/y-offset/location/anchor).
   Width is intentionally tight (320px) so rows read as compact pills
   instead of stretched bars: a 30px-radius pill at ~308px wide reads
   as a capsule, the closest analog to the bar's short content-fit pills.
   Window padding 4px keeps the breathing space minimal — bar pills sit
   directly on the bar veil with no container padding.
   IMPORTANT: keep this width in sync with ROFI_DEFAULT_WIDTH in
   scripts/lib/rofi-anchor.sh (the anchor math assumes window width). */
window {
    width:            320px;
    /* padding: top right bottom left — top is 0 so the first row sits
       flush at the popup's top edge, butting up against the bar.
       Sides + bottom keep 4px breathing room so pills don't touch the
       window's bar-veil border-radius. */
    padding:          0 4px 4px 4px;
    background-color: @opt-bar-veil;
    /* border-radius: top-left top-right bottom-right bottom-left. Top
       corners squared so the popup's top edge meets the bar's bottom
       edge with no rounded notch; bottom corners stay 30px to match
       waybar's pill rounding. */
    border-radius:    0 0 30px 30px;
}

mainbox {
    padding: 0;
    spacing: 4px;
    children: ["listview"];
}

listview {
    /* spacing 0 — between-pill breathing space is carried by each
       element's own `margin: 1px 0px`, mirroring waybar exactly. */
    spacing:      0;
    scrollbar:    false;
    fixed-height: 0;
    lines:        12;
}

/* Row, default — parent-surface pill at rest (mirrors .opt-pill).
   Hover film replaces the surface to brighten on selection.
   Properties from waybar/style.css:200-207 (with one adjustment noted
   below):
     border-radius: 30px;
     color:         @opt-text-on-dark;  (rasi: text-color, theme-flipped)
     padding:       3px 8px 3px 7px;    → 6px 8px 6px 7px here
     margin:        1px 0px;
   Why the vertical-padding bump (3→6): waybar pills contain Font
   Awesome / Nerd Font glyph icons (bell, gear, bluetooth, …) that
   render at ~1.6em (≈21px) — larger than 13px text, so the icons
   visually inflate the bar pills to ~21px text-content + 6px padding
   = ~27px tall. The popup rows are text-only (timestamps + names) so
   13px text + 3px padding renders only ~19px tall, a noticeably
   thinner pill. Adding 6 logical px to vertical padding closes the
   visible gap so a popup pill reads as the same thickness as a bar
   pill containing a Nerd Font icon. Horizontal padding stays at the
   verbatim waybar value. */
element {
    padding:          6px 8px 6px 7px;
    margin:           1px 0px;
    border-radius:    30px;
    background-color: @opt-surface-parent;
    text-color:       @opt-text;
    cursor:           pointer;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        inherit;
}

element-icon {
    padding: 0 6px 0 0;
    size:    1.6em;
}

/* Universal bright-hover — mirrors waybar/style.css:220-221:
     window#waybar .opt-pill:hover,
     window#waybar .opt-pill-child:hover { box-shadow: inset 0 0 0 999px @opt-hover-bright; }
   waybar layers a white 0.30 film OVER the existing background-color via
   inset box-shadow. rofi/cairo accepts neither inset box-shadow nor
   variable references inside linear-gradient on rofi 2.0.0, so we
   express the SAME visual outcome using precomputed alpha composites.
   Math (source-over): result_alpha = α_s + α_d(1-α_s), result_color =
   (C_s·α_s + C_d·α_d(1-α_s)) / result_alpha. With α_s = α_d = 0.30:
     parent gray 128 + white film → rgba(203, 203, 203, 0.51)
     child  gray 170 + white film → rgba(220, 220, 220, 0.51)
   These render identically over the wallpaper to layering the two
   tokens, confirmed by the alpha-composite identity:
     wallpaper·(1 - α_combined) + composite·α_combined
       == (wallpaper·0.70 + 128·0.30)·0.70 + 255·0.30
   Both reduce to wallpaper·0.49 + 103.4 (± rounding). Identity preserved:
   action pills (220) stay brighter than normal pills (203) on hover. */
element selected.normal {
    background-color: @opt-hover-on-parent;
    text-color:       @opt-text;
}
element selected.active {
    background-color: @opt-hover-on-child;
    text-color:       @opt-text;
}
element selected.urgent {
    /* Headers stay dim even when keyboard-navigated over — no hover film.
       The notif-menu L1 dispatcher no-ops on header indices anyway. */
    background-color: transparent;
    text-color:       @opt-text-dim;
}

/* Action rows — emitted by format_rofi_action with a leading \x02
   sentinel. rofi treats them as `active` rows; we give them the child
   surface so they read as action pills. Padding inherited from
   `element` above — waybar uses identical padding/radius for
   .opt-pill and .opt-pill-child. */
element normal.active {
    background-color: @opt-surface-child;
    border-radius:    30px;
}

/* Section headers — emitted with the existing dim-non-selectable
   format. rofi treats them as `urgent` rows; we make them small + dim
   and non-clickable visually. The smaller font lets the headers recede
   behind the pill labels. Size in px to match the body's px sizing
   (without px Pango would render this as 11pt ≈ 14.7px, BIGGER than
   the body's 13px — exactly the inverse of the intended hierarchy). */
element normal.urgent {
    background-color: transparent;
    text-color:       @opt-text-dim;
    font:             "MesloLGS NF, Font Awesome 7 Free, Symbols Nerd Font Mono 11px";
    /* padding: top right bottom left — top is 0 so the first header
       (e.g. "Actions") sits at the popup's top edge, against the bar. */
    padding:          0 12px 0 12px;
    margin:           0;
    cursor:           default;
}
element normal.urgent element-text {
    text-color: @opt-text-dim;
}
