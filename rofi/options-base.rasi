/*
 * options-base.rasi — shared shape and surface rules for every rofi
 * surface in OPTIONS. The light and dark theme files @import this and
 * set @opt-surface-parent / @opt-surface-child / @opt-text constants.
 *
 * Soul rule: rofi IS a fragment of the bar dropped down — bar-veil
 * window with pills inside, mirroring window#waybar's structure.
 * - Window: bar-veil surface, rounded, NO hard border (Rule 3).
 * - Notif rows (records): parent surface (mirrors .opt-pill at rest).
 * - Action rows (verbs): child surface (mirrors .opt-pill-child).
 * - Selected row: white film 0.30 alpha (universal bright-hover).
 * - Section headers: smaller font, dim, no pill surface.
 *
 * Color tokens are defined in options-dark.rasi / options-light.rasi
 * and mirror the @define-color block in waybar/style.css exactly:
 *   opt-surface-parent  rgba(128, 128, 128, 0.30)  — universal neutral glass
 *   opt-surface-child   rgba(170, 170, 170, 0.30)  — universal brighter glass
 *   opt-hover-bright    rgba(255, 255, 255, 0.30)  — universal white film
 *   opt-text            rgba(255, 255, 255, 1.00)  — dark: opt-text-on-dark
 *                       rgba(  0,   0,   0, 0.85)  — light: opt-text-on-light
 *   opt-text-dim        dark: 55% alpha white / light: 55% alpha black
 */

configuration {
    font: "MesloLGS NF 13";
    /* show-icons: false — notif-menu and the other current rofi callers
       emit text-only rows. With show-icons: true rofi reserves a 1.6em
       slot for an icon container per row even when no icon path is
       provided, leaving a blank gap to the left of every text cell. */
    show-icons: false;
    me-select-entry: "MouseSecondary";
    me-accept-entry: "MousePrimary";
    hover-select: true;
    click-to-exit: true;
}

* {
    background-color: transparent;
    text-color:       @opt-text;
    border:           0px;            /* Rule 3: no hard borders */
}

/* Window — the bar-veil container. Position is overridden by the
   launcher's -theme-str (x-offset/y-offset/location/anchor).
   Width is intentionally tight (320px) so rows read as compact pills
   instead of stretched bars: a 30px-radius pill at ~308px wide reads
   as a capsule, the closest analog to the bar's short content-fit pills.
   Window padding 4px keeps the breathing space minimal — bar pills sit
   directly on the bar veil with no container padding.
   IMPORTANT: keep this width in sync with ROFI_DEFAULT_WIDTH in
   scripts/lib/rofi-anchor.sh (the anchor math assumes window width). */
window {
    width:            320px;
    padding:          4px;
    background-color: @opt-bar-veil;
    border-radius:    30px;
}

mainbox {
    padding: 0;
    spacing: 4px;
    children: ["listview"];
}

listview {
    spacing:      2px;
    scrollbar:    false;
    fixed-height: 0;
    lines:        12;
}

/* Row, default — parent-surface pill at rest (mirrors .opt-pill).
   Hover film replaces the surface to brighten on selection.
   Padding + border-radius are copy-verbatim from
   waybar/style.css `.opt-pill` (lines 200-207). */
element {
    padding:          3px 8px 3px 7px;
    border-radius:    30px;
    background-color: @opt-surface-parent;
    cursor:           pointer;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        inherit;
}

element-icon {
    padding: 0 6px 0 0;
    size:    1.6em;
}

/* Universal bright-hover — selected row gets a white 0.30 alpha film
   over whatever surface is beneath. Matches waybar's .opt-pill:hover
   which applies inset 0 0 0 999px @opt-hover-bright via box-shadow. */
element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @opt-hover-bright;
    text-color:       @opt-text;
}

/* Action rows — emitted by format_rofi_action with a leading \x02
   sentinel. rofi treats them as `active` rows; we give them the child
   surface so they read as action pills. Padding inherited from
   `element` above — waybar uses identical padding/radius for
   .opt-pill and .opt-pill-child. */
element normal.active {
    background-color: @opt-surface-child;
    border-radius:    30px;
}

/* Section headers — emitted with the existing dim-non-selectable
   format. rofi treats them as `urgent` rows; we make them small + dim
   and non-clickable visually. The smaller font lets the headers recede
   behind the pill labels. */
element normal.urgent {
    background-color: transparent;
    text-color:       @opt-text-dim;
    font:             "MesloLGS NF 11";
    padding:          4px 12px 0;
    cursor:           default;
}
element normal.urgent element-text {
    text-color: @opt-text-dim;
}
