#!/usr/bin/env python3
"""
notif-os-daemon — Standard-OS native notification daemon.

Owns org.freedesktop.Notifications on the session bus AND a sibling
extension interface org.standardos.NotifOS for richer queries that the
freedesktop spec doesn't cover (full notif data by id, source-window
attribution, sender PID).

Design:
- Each Notify call captures:
    * the standard fields (app_name, summary, body, actions, hints, urgency)
    * the sender's unique D-Bus name → resolved to PID via DBus.GetConnectionUnixProcessID
    * the active Hyprland window address via `hyprctl activewindow`
    * a monotonic timestamp
- All notifs are stored in an in-memory dict keyed by uint32 id.
- A side-effect: every Notify writes a line to ~/.local/share/standard-os/notif-history.jsonl
  with the same JSON shape the existing notif-journal.sh uses, plus the new
  source_window + sender_pid fields.
- ActionInvoked and NotificationClosed signals are emitted per the spec when
  notif-menu / the user invokes via the extension interface.

POC scope:
- No popup display. The bell pill + notif-menu are the UX.
- No DND / inhibitors (defer to the bash notif-daemon's existing profile logic
  layered on top in a follow-up).
- No image-data hint storage (only the small fields).
- replaces_id handled minimally (reuse id if matched).

The daemon is intentionally fail-loud: a missing dbus-next or other dep is a
fast crash, not a silent degradation.
"""

import asyncio
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

try:
    from dbus_next.aio import MessageBus
    from dbus_next.service import ServiceInterface, method, signal
    from dbus_next import BusType, Variant
except ImportError:
    sys.stderr.write(
        "notif-os-daemon: dbus-next missing — install python3Packages.dbus-next.\n"
    )
    sys.exit(1)


JOURNAL_PATH = Path(
    os.environ.get("NOTIF_JOURNAL")
    or (Path.home() / ".local/share/standard-os/notif-history.jsonl")
)
JOURNAL_LIMIT = int(os.environ.get("NOTIF_JOURNAL_LIMIT", "200"))


def now_iso() -> str:
    """ISO 8601 timestamp with offset, second precision (matches notif-journal.sh)."""
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def journal_append_line(record: dict) -> None:
    """Append one JSON line to the journal, pruning to JOURNAL_LIMIT entries."""
    JOURNAL_PATH.parent.mkdir(parents=True, exist_ok=True)
    line = json.dumps(record, separators=(",", ":"), ensure_ascii=False)
    with JOURNAL_PATH.open("a", encoding="utf-8") as f:
        f.write(line + "\n")
    # Prune (cheap; only fires occasionally past the limit).
    try:
        with JOURNAL_PATH.open("r", encoding="utf-8") as f:
            lines = f.readlines()
        if len(lines) > JOURNAL_LIMIT:
            tmp = JOURNAL_PATH.with_suffix(JOURNAL_PATH.suffix + ".tmp")
            tmp.write_text("".join(lines[-JOURNAL_LIMIT:]), encoding="utf-8")
            tmp.replace(JOURNAL_PATH)
    except OSError:
        pass


def hypr_active_window_address() -> str:
    """Returns Hyprland's currently active window address, or empty string."""
    hyprctl = shutil.which("hyprctl")
    if not hyprctl:
        return ""
    try:
        out = subprocess.run(
            [hyprctl, "-j", "activewindow"],
            capture_output=True,
            text=True,
            timeout=0.5,
        )
        data = json.loads(out.stdout or "{}")
        return data.get("address") or ""
    except (subprocess.SubprocessError, json.JSONDecodeError, OSError):
        return ""


class FreedesktopNotifications(ServiceInterface):
    """org.freedesktop.Notifications — the standard spec we serve."""

    def __init__(self, store):
        super().__init__("org.freedesktop.Notifications")
        self.store = store
        self._next_id = 1

    # ── Standard methods ────────────────────────────────────────────────

    @method()
    async def Notify(  # noqa: N802 — spec name
        self,
        app_name: "s",  # type: ignore[name-defined]
        replaces_id: "u",  # type: ignore[name-defined]
        app_icon: "s",  # type: ignore[name-defined]
        summary: "s",  # type: ignore[name-defined]
        body: "s",  # type: ignore[name-defined]
        actions: "as",  # type: ignore[name-defined]
        hints: "a{sv}",  # type: ignore[name-defined]
        expire_timeout: "i",  # type: ignore[name-defined]
    ) -> "u":  # type: ignore[name-defined]
        if replaces_id and replaces_id in self.store.notifs:
            nid = replaces_id
        else:
            nid = self._next_id
            self._next_id += 1

        # Resolve sender PID via the D-Bus daemon's GetConnectionUnixProcessID.
        sender_pid = await self.store.resolve_sender_pid(self._last_sender())

        # urgency hint is a byte (y)
        urgency = 1
        if "urgency" in hints:
            try:
                urgency = int(hints["urgency"].value)
            except (AttributeError, ValueError):
                pass

        # Flatten the action list: spec is [key0, label0, key1, label1, ...]
        action_pairs = []
        it = iter(actions)
        for k in it:
            label = next(it, k)
            action_pairs.append((k, label))

        source_window = hypr_active_window_address()

        record = {
            "id": nid,
            "app": app_name,
            "summary": summary,
            "body": body,
            "urgency": urgency,
            "actions": action_pairs,
            "app_icon": app_icon,
            "sender_pid": sender_pid,
            "source_window": source_window,
            "ts": now_iso(),
            "dismissed_at": "",
        }
        self.store.notifs[nid] = record

        # Journal write — same shape the existing notif-journal.sh produces,
        # plus our new sender_pid + source_window fields.
        journal_append_line(
            {
                "ts": record["ts"],
                "id": nid,
                "app": app_name,
                "summary": summary,
                "body": body,
                "urgency": urgency,
                "dismissed_at": "",
                "source_window": source_window,
                "sender_pid": sender_pid,
            }
        )

        return nid

    @method()
    async def CloseNotification(self, id: "u") -> None:  # type: ignore[name-defined] # noqa: N802
        if id in self.store.notifs:
            del self.store.notifs[id]
            # Reason: 3 = closed by a call to CloseNotification.
            self.NotificationClosed(id, 3)

    @method()
    def GetCapabilities(self) -> "as":  # type: ignore[name-defined] # noqa: N802
        return ["actions", "body", "body-markup", "persistence"]

    @method()
    def GetServerInformation(self) -> "ssss":  # type: ignore[name-defined] # noqa: N802
        return ("notif-os-daemon", "Standard-OS", "0.1.0", "1.2")

    # ── Standard signals ────────────────────────────────────────────────

    @signal()
    def NotificationClosed(self, id: "u", reason: "u") -> "uu":  # type: ignore[name-defined] # noqa: N802
        return [id, reason]

    @signal()
    def ActionInvoked(self, id: "u", action_key: "s") -> "us":  # type: ignore[name-defined] # noqa: N802
        return [id, action_key]

    # ── Internal helpers ────────────────────────────────────────────────

    def _last_sender(self) -> str:
        """Best-effort: extract the sender unique name from the most recent
        message. dbus-next stores it on the underlying message object during
        method dispatch — we read it via the daemon's stash."""
        return self.store.last_sender or ""


class StandardOSExt(ServiceInterface):
    """org.standardos.NotifOS — our extension interface.

    Gives notif-menu and the bash notif-daemon a clean read/write API:
      - ListNotifications: full current state as JSON.
      - InvokeAction:      fires the standard ActionInvoked signal AND closes.
    """

    def __init__(self, store, freedesktop):
        super().__init__("org.standardos.NotifOS")
        self.store = store
        self.fd = freedesktop

    @method()
    def ListNotifications(self) -> "s":  # type: ignore[name-defined] # noqa: N802
        """JSON-encoded list of all current notifs. Returns "[]" when empty."""
        # Build a list ordered by id ascending (most recent last) — newest-first
        # ordering is handled by consumers via the journal's tac.
        out = []
        for nid in sorted(self.store.notifs.keys()):
            r = self.store.notifs[nid]
            out.append(
                {
                    "id": r["id"],
                    "app": r["app"],
                    "summary": r["summary"],
                    "body": r["body"],
                    "urgency": r["urgency"],
                    "actions": r["actions"],
                    "sender_pid": r["sender_pid"],
                    "source_window": r["source_window"],
                    "ts": r["ts"],
                }
            )
        return json.dumps(out, separators=(",", ":"), ensure_ascii=False)

    @method()
    def InvokeAction(self, id: "u", action_key: "s") -> "b":  # type: ignore[name-defined] # noqa: N802
        """Fires ActionInvoked(id, action_key) on org.freedesktop.Notifications,
        then closes the notif. Returns false if the id is unknown."""
        if id not in self.store.notifs:
            return False
        self.fd.ActionInvoked(id, action_key)
        del self.store.notifs[id]
        self.fd.NotificationClosed(id, 2)  # 2 = dismissed by user
        return True

    @method()
    def Count(self) -> "u":  # type: ignore[name-defined]
        return len(self.store.notifs)


class Store:
    """Shared mutable state — notifs dict + last seen sender for PID resolution."""

    def __init__(self, bus):
        self.notifs: dict[int, dict] = {}
        self.bus = bus
        self.last_sender = ""

    async def resolve_sender_pid(self, sender: str) -> int:
        """Calls org.freedesktop.DBus.GetConnectionUnixProcessID."""
        if not sender:
            return 0
        try:
            introspection = await self.bus.introspect("org.freedesktop.DBus", "/org/freedesktop/DBus")
            obj = self.bus.get_proxy_object("org.freedesktop.DBus", "/org/freedesktop/DBus", introspection)
            iface = obj.get_interface("org.freedesktop.DBus")
            pid = await iface.call_get_connection_unix_process_id(sender)
            return int(pid)
        except Exception:
            return 0


async def main() -> int:
    bus = await MessageBus(bus_type=BusType.SESSION).connect()
    store = Store(bus)

    fd_iface = FreedesktopNotifications(store)
    ext_iface = StandardOSExt(store, fd_iface)

    # Patch dbus-next to stash the sender name on every method call so the
    # Notify handler can resolve PID. dbus-next doesn't expose sender directly
    # on the ServiceInterface; we hook into its dispatch via a thin proxy.
    original = bus._process_message  # type: ignore[attr-defined]

    def patched_process(msg):
        try:
            if msg and getattr(msg, "sender", None):
                store.last_sender = msg.sender
        except Exception:
            pass
        return original(msg)

    bus._process_message = patched_process  # type: ignore[attr-defined]

    bus.export("/org/freedesktop/Notifications", fd_iface)
    bus.export("/org/standardos/NotifOS", ext_iface)

    await bus.request_name("org.freedesktop.Notifications")
    await bus.request_name("org.standardos.NotifOS")

    sys.stderr.write("notif-os-daemon: ready on org.freedesktop.Notifications + org.standardos.NotifOS\n")
    sys.stderr.flush()

    await asyncio.Future()  # run forever
    return 0


if __name__ == "__main__":
    try:
        sys.exit(asyncio.run(main()))
    except KeyboardInterrupt:
        sys.exit(0)
