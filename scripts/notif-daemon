#!/usr/bin/env bash
# notif-daemon — OPTIONS notification-center spine.
#
# Subscribes to org.freedesktop.Notifications + fr.emersion.mako via
# dbus-monitor, queries mako via makoctl for authoritative state, and writes
# /tmp/waybar-cache/notif (atomic) that the custom/notif waybar pill renders.
#
# Spine spec:
#   waybar/docs/superpowers/specs/2026-06-06-notification-center-spine-design.md
# §"Pill state machine" is the authoritative behavior table. render_cache_for_state
# below is the encoding of that table — pure function, no side effects, safe to
# source from tests via NOTIF_DAEMON_LIB_ONLY=1.
#
# Hazard checklist (from waybar/CLAUDE.md):
#   - class field is a JSON ARRAY (never space-separated string)
#   - cache writes are atomic (tmp + mv -f)
#   - RTMIN+12 fires only on real-content change (dedup at writer)
#   - no per-tick jq / awk / head / tr forks in hot paths (bash builtins)
#   - DBus FD opened ONCE with exec {FD}<…; reads via -u "$FD"
#   - light/dark adaptation: `dark` class emitted unconditionally for non-empty
#     state. (Glass-text-daemon flips the live class; for now we hardcode dark
#     and rely on the glass-text rule to swap when implemented in a follow-up.)

set -uo pipefail

# ─── json_escape — escape strings for embedding in JSON values ────────────
# Notification fields arrive un-escaped from D-Bus. A single un-escaped
# quote in a title corrupts the entire cache file and waybar renders an
# empty pill. Order matters: backslash MUST be escaped BEFORE quote, or
# the inserted `\` (from `"` → `\"`) gets double-escaped by the backslash
# pass. The order in this body reflects that constraint — do not reorder.
json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# ─── Pure render function ──────────────────────────────────────────────────
# Encoding of the §"Pill state machine" table from the spine spec.
#
# Args (positional):
#   $1 unread     — total unread count (mako history list length)
#   $2 critical   — critical unread count (urgency=2 entries)
#   $3 dnd        — 0 or 1. NOT consulted here; the daemon's main loop is
#                   responsible for upstream suppression of normal/low
#                   transients when DND is on. Render is pure: given the
#                   final state, produce the canonical JSON.
#   $4 kind       — '' | 'normal' | 'critical' | 'critical_acked'
#   $5 app        — origin app name (when kind != '')
#   $6 title      — notification summary (when kind != '')
#   $7 body       — notification body for the tooltip (when kind != '')
#
# Stdout: JSON object matching the row in §"Pill state machine" for the
# inputs. Empty state emits `{"text":""}` so waybar hides the module.
render_cache_for_state() {
    local unread="${1:-0}"
    local critical="${2:-0}"
    local _dnd="${3:-0}"   # reserved; not used in render — see Args note above
    local kind="${4:-}"
    local app="${5:-}"
    local title="${6:-}"
    local body="${7:-}"

    # Font Awesome solid bell U+F0F3. Built from raw UTF-8 bytes so this
    # source file never has to hold a PUA codepoint (some editors strip
    # PUA silently). Verify with: printf '%s' "$bell" | od -An -c
    local bell=$'\xef\x83\xb3'

    # Transient or acked-critical state — wide pill with App · Title.
    if [[ -n $kind ]]; then
        local classes
        case "$kind" in
            normal)
                classes='["opt-pill","dark","opt-flash"]'
                ;;
            critical)
                classes='["opt-pill","dark","opt-no","opt-pulse-orange","opt-flash"]'
                ;;
            critical_acked)
                classes='["opt-pill","dark","opt-no","opt-pin-orange"]'
                ;;
            *)
                # Unknown kind: defensive — use the safest visible state.
                # (Should never happen if the daemon's state machine is sound.)
                classes='["opt-pill","dark","opt-flash"]'
                ;;
        esac
        printf '{"text":"%s %s · %s","class":%s,"tooltip":"%s"}' \
            "$bell" "$app" "$title" "$classes" "$body"
        return 0
    fi

    # Rest faces — bell glyph, pin colour by criticality.
    if (( unread <= 0 )); then
        printf '{"text":""}'
        return 0
    fi

    if (( critical > 0 )); then
        printf '{"text":"%s","class":["opt-pill","dark","opt-pin-orange"],"tooltip":"Notifications"}' "$bell"
    else
        printf '{"text":"%s","class":["opt-pill","dark","opt-pin-green"],"tooltip":"Notifications"}' "$bell"
    fi
}

# ─── render_bell_for_state (P1 design) ─────────────────────────────────────
# The bell parent pill carries ALL state: pin color at rest, transient face
# during the 5s arrival window, opt-pushed composing with DND. Pure function.
#
# Args:
#   $1 unread      — total unread count
#   $2 critical    — critical unread count
#   $3 dnd_on      — 0 or 1
#   $4 kind        — '' | 'normal' | 'critical'  (transient kind)
#   $5 app         — origin app (when kind != '')
#   $6 title       — summary (when kind != '')
#   $7 body        — body (tooltip text when transient)
render_bell_for_state() {
    local unread="${1:-0}" critical="${2:-0}" dnd_on="${3:-0}"
    local kind="${4:-}" app="${5:-}" title="${6:-}" body="${7:-}"

    # FA solid bell U+F0F3, raw UTF-8 bytes — verify with od -An -c if you edit
    local bell=$'\xef\x83\xb3'

    # Build the class array as positional args, then format as JSON array literal
    local -a classes=("opt-pill" "dark")

    if [[ -n $kind ]]; then
        # Transient face: wide pill, App · Title text. NO opt-flash on normal
        # (Rule 4 silent context shift). Critical adds opt-no + opt-pulse-orange
        # (urgency mandate pierces the silent rule, matches the spine).
        case "$kind" in
            critical)
                classes+=("opt-no" "opt-pulse-orange")
                ;;
            normal)
                # No additional classes — silent normal arrival (Rule 4).
                ;;
            *)
                # Defensive: unknown kind treated as silent normal. The runtime
                # state machine only ever produces 'normal' or 'critical'; this
                # branch is dead in practice but keeps render pure.
                ;;
        esac
        (( dnd_on == 1 )) && classes+=("opt-pushed")
        local classes_json
        _classes_json classes_json "${classes[@]}"
        # Self-contained: escape app/title/body for JSON. The legacy renderer
        # required callers to pre-escape; the new renderer owns its quoting so
        # waybar never sees broken JSON when a notification has " or \ in any
        # field (D-Bus does NOT escape these for us).
        local app_esc title_esc body_esc
        app_esc=$(json_escape "$app")
        title_esc=$(json_escape "$title")
        body_esc=$(json_escape "$body")
        printf '{"text":"%s · %s","class":%s,"tooltip":"%s"}' \
            "$app_esc" "$title_esc" "$classes_json" "$body_esc"
        return 0
    fi

    # Rest face: bell glyph, pin color reflects urgency.
    if (( unread > 0 )); then
        if (( critical > 0 )); then
            classes+=("opt-pin-orange")
        else
            classes+=("opt-pin-green")
        fi
    fi
    (( dnd_on == 1 )) && classes+=("opt-pushed")

    local classes_json
    _classes_json classes_json "${classes[@]}"
    printf '{"text":"%s","class":%s,"tooltip":"Notifications"}' "$bell" "$classes_json"
}

# ─── render_dnd_for_state ──────────────────────────────────────────────────
# The DND child pill. Material Design bell-slash U+F009B (4-byte UTF-8).
# Pure function — only state input is dnd_on.
render_dnd_for_state() {
    local dnd_on="${1:-0}"
    # U+F009B (Material Design bell-off) = 0xF3 0xB0 0x82 0x9B in UTF-8.
    # If this byte sequence ever looks empty in your terminal, verify with:
    #   printf '%s' "$slash" | od -An -tx1   → "f3 b0 82 9b"
    local slash=$'\xf3\xb0\x82\x9b'
    if (( dnd_on == 1 )); then
        printf '{"text":"%s","class":["opt-pill-child","dark","opt-pushed"],"tooltip":"Do Not Disturb (on)"}' "$slash"
    else
        printf '{"text":"%s","class":["opt-pill-child","dark"],"tooltip":"Do Not Disturb"}' "$slash"
    fi
}

# ─── _classes_json VAR <class>... ──────────────────────────────────────────
# Builds a JSON array literal from positional class args, writes result to VAR
# via printf -v (no subshell fork). Defensively escapes " and \ in each class
# name so future external inputs (per-app classes from silencedApps, etc.)
# cannot produce malformed JSON. Internal classes (opt-pill, opt-pushed, ...)
# never need this, but the cost is zero and the safety net is permanent.
_classes_json() {
    local __var="$1"; shift
    local out="[" first=1 c esc
    for c in "$@"; do
        esc="${c//\\/\\\\}"
        esc="${esc//\"/\\\"}"
        if (( first )); then
            out+="\"$esc\""
            first=0
        else
            out+=",\"$esc\""
        fi
    done
    out+="]"
    printf -v "$__var" '%s' "$out"
}

# ─── Library-only short-circuit ────────────────────────────────────────────
# When sourced from tests/notif-state-test.sh with NOTIF_DAEMON_LIB_ONLY=1,
# only the function definitions above are needed — the main loop must not
# run. Exit/return safely whether we were sourced or executed.
if [[ "${NOTIF_DAEMON_LIB_ONLY:-0}" == "1" ]]; then
    return 0 2>/dev/null || exit 0
fi

# ─── Configuration ─────────────────────────────────────────────────────────
CACHE="${NOTIF_CACHE:-/tmp/waybar-cache/notif}"
SIGNAL="${NOTIF_SIGNAL:-12}"
# Auto-calm timers (whole seconds — read -t accepts fractional but our
# timers are in 4-second ranges so integer precision is fine).
TRANSIENT_NORMAL_SEC=4    # collapse normal/low transients after this many sec
TRANSIENT_CRITICAL_CALM_SEC=4    # critical: animate, then calm to pin-orange
TRANSIENT_CRITICAL_END_SEC=8     # critical: collapse to home after total

mkdir -p "$(dirname "$CACHE")"

# ─── State variables (single source of truth for the pill) ─────────────────
UNREAD_COUNT=0
CRITICAL_COUNT=0
LAST_KNOWN_TOP_ID=0
TRANSIENT_KIND=""
TRANSIENT_ID=0              # mako id of the notification this transient represents
TRANSIENT_APP=""
TRANSIENT_TITLE=""
TRANSIENT_BODY=""
TRANSIENT_START=0           # epoch seconds when current transient began
LAST_RENDERED=""            # dedup — only signal waybar on real change
# Set by query_mako_state alongside UNREAD/CRITICAL.
UNREAD_IDS=""               # space-separated ids currently in mako's history

# ─── mako D-Bus interrogation ──────────────────────────────────────────────
# mako 1.10's `makoctl list` returns a HUMAN-READABLE plain-text format,
# not JSON — there is no `-j`/`--json` flag. The authoritative source for
# structured data is mako's own D-Bus interface, queried via
# `busctl --json=short`. The reply schema matches what the spec design doc
# anticipated:  `.data[0][].{id,urgency,summary,body,"app-name"}.data`.
#
# Sets the seven NEWEST_* / *_COUNT globals.
query_mako_state() {
    local json
    json=$(busctl --user --json=short call \
        org.freedesktop.Notifications /fr/emersion/Mako \
        fr.emersion.Mako ListNotifications 2>/dev/null) || json=""
    if [[ -z $json || $json == "null" ]]; then
        UNREAD_COUNT=0; CRITICAL_COUNT=0
        NEWEST_ID=0; NEWEST_URG=1
        NEWEST_APP=""; NEWEST_SUMMARY=""; NEWEST_BODY=""
        return
    fi
    # Newest = highest id (mako returns notifications in arbitrary order).
    UNREAD_COUNT=$(printf '%s' "$json" | jq -r '.data[0] | length // 0' 2>/dev/null) || UNREAD_COUNT=0
    CRITICAL_COUNT=$(printf '%s' "$json" | jq -r '[.data[0][]? | select(.urgency.data == 2)] | length' 2>/dev/null) || CRITICAL_COUNT=0
    UNREAD_IDS=$(printf '%s' "$json" | jq -r '[.data[0][]?.id.data] | join(" ")' 2>/dev/null) || UNREAD_IDS=""
    NEWEST_ID=$(printf '%s' "$json" | jq -r '[.data[0][]?.id.data] | max // 0' 2>/dev/null) || NEWEST_ID=0
    NEWEST_URG=$(printf '%s' "$json" | jq -r "[.data[0][]? | select(.id.data == $NEWEST_ID)][0].urgency.data // 1" 2>/dev/null) || NEWEST_URG=1
    NEWEST_APP=$(printf '%s' "$json" | jq -r "[.data[0][]? | select(.id.data == $NEWEST_ID)][0].\"app-name\".data // \"\"" 2>/dev/null) || NEWEST_APP=""
    NEWEST_SUMMARY=$(printf '%s' "$json" | jq -r "[.data[0][]? | select(.id.data == $NEWEST_ID)][0].summary.data // \"\"" 2>/dev/null) || NEWEST_SUMMARY=""
    NEWEST_BODY=$(printf '%s' "$json" | jq -r "[.data[0][]? | select(.id.data == $NEWEST_ID)][0].body.data // \"\"" 2>/dev/null) || NEWEST_BODY=""
}

dnd_on() {
    # Return 0 (success/true) when DND mode is engaged.
    # `makoctl mode` returns plain text — one mode name per line.
    makoctl mode 2>/dev/null | grep -qx 'dnd'
}

# ─── Transient lifecycle ───────────────────────────────────────────────────
clear_transient() {
    TRANSIENT_KIND=""
    TRANSIENT_ID=0
    TRANSIENT_APP=""
    TRANSIENT_TITLE=""
    TRANSIENT_BODY=""
    TRANSIENT_START=0
}

# Has the notification this transient represents disappeared from mako?
# Called after every query_mako_state in on_dbus_event so a click-dismiss
# (or any external dismissal) drops the transient face immediately.
transient_id_still_unread() {
    [[ -z $TRANSIENT_KIND ]] && return 0
    (( TRANSIENT_ID == 0 )) && return 0
    local id
    for id in $UNREAD_IDS; do
        (( id == TRANSIENT_ID )) && return 0
    done
    return 1
}

# Called when query_mako_state finds a NEWEST_ID we haven't seen before.
# Sets up the appropriate transient kind based on urgency + DND.
#
# Surfacing rules per spec § Verification (1):
#   urgency=0 (low)     → NO transient ever; goes to history + rest pin only.
#                         KDE convention — reduces noise from print-jobs,
#                         BT/WiFi connect events, package-mgr chatter.
#   urgency=1 (normal)  → transient unless DND is on.
#   urgency=2 (critical)→ transient ALWAYS (DND pierces per spec mandate).
on_arrival() {
    local urg="$NEWEST_URG"
    if (( urg == 2 )); then
        TRANSIENT_KIND="critical"
    elif (( urg == 0 )); then
        # Low → silent. The arrival still bumps UNREAD_COUNT in the next
        # query, so rest face gets pin-green automatically.
        return 0
    elif dnd_on; then
        # Normal + DND on → no transient.
        return 0
    else
        TRANSIENT_KIND="normal"
    fi
    TRANSIENT_ID="$NEWEST_ID"
    TRANSIENT_APP="$NEWEST_APP"
    TRANSIENT_TITLE="$NEWEST_SUMMARY"
    TRANSIENT_BODY="$NEWEST_BODY"
    TRANSIENT_START=$(date +%s)
}

# Walk the transient state machine forward by elapsed time.
# Returns 0 if state changed (caller should re-render), 1 otherwise.
check_transient_timers() {
    [[ -z $TRANSIENT_KIND ]] && return 1
    local now elapsed
    now=$(date +%s)
    elapsed=$(( now - TRANSIENT_START ))
    case "$TRANSIENT_KIND" in
        normal)
            if (( elapsed >= TRANSIENT_NORMAL_SEC )); then
                clear_transient
                return 0
            fi
            ;;
        critical)
            if (( elapsed >= TRANSIENT_CRITICAL_CALM_SEC )); then
                TRANSIENT_KIND="critical_acked"
                return 0
            fi
            ;;
        critical_acked)
            if (( elapsed >= TRANSIENT_CRITICAL_END_SEC )); then
                clear_transient
                return 0
            fi
            ;;
    esac
    return 1
}

# Seconds until the next timer fires, used as `read -t` budget. Returns a
# generous block-forever sentinel (3600s) when no transient is active.
next_tick_seconds() {
    [[ -z $TRANSIENT_KIND ]] && { printf '3600'; return; }
    local now elapsed target
    now=$(date +%s)
    elapsed=$(( now - TRANSIENT_START ))
    case "$TRANSIENT_KIND" in
        normal)         target="$TRANSIENT_NORMAL_SEC" ;;
        critical)       target="$TRANSIENT_CRITICAL_CALM_SEC" ;;
        critical_acked) target="$TRANSIENT_CRITICAL_END_SEC" ;;
        *)              target=4 ;;
    esac
    local remaining=$(( target - elapsed ))
    (( remaining < 1 )) && remaining=1
    printf '%d' "$remaining"
}

# ─── Cache write with dedup + waybar signal ────────────────────────────────
emit() {
    query_mako_state    # refresh UNREAD/CRITICAL from authoritative source
    local app_esc title_esc body_esc rendered
    app_esc=$(json_escape "$TRANSIENT_APP")
    title_esc=$(json_escape "$TRANSIENT_TITLE")
    body_esc=$(json_escape "$TRANSIENT_BODY")
    rendered=$(render_cache_for_state \
        "$UNREAD_COUNT" "$CRITICAL_COUNT" 0 \
        "$TRANSIENT_KIND" "$app_esc" "$title_esc" "$body_esc")
    [[ "$rendered" == "$LAST_RENDERED" ]] && return 0
    LAST_RENDERED="$rendered"
    local tmp="${CACHE}.tmp.$$"
    printf '%s' "$rendered" > "$tmp" && mv -f "$tmp" "$CACHE"
    pkill -RTMIN+"$SIGNAL" waybar 2>/dev/null || true
}

# ─── D-Bus event handler ───────────────────────────────────────────────────
# A single helper that recomputes state and decides whether the change
# represents an arrival worth transient-pilling. Called after a dbus-monitor
# event has been drained (we ignore the line content — we just use mako's
# authoritative state).
on_dbus_event() {
    # Brief delay so mako can ingest the Notify before we query its list.
    # If mako had a post-processing D-Bus signal we could subscribe to that
    # instead — until verified, the tick is the robust fallback.
    sleep 0.05
    local prev_top_id="$LAST_KNOWN_TOP_ID"
    query_mako_state
    if (( NEWEST_ID > prev_top_id )); then
        on_arrival
    fi
    # If the notification that drives our current transient was dismissed
    # (by click, by another invoker, by mako expiry), drop the transient
    # face immediately so the pill returns to its rest or empty state.
    if ! transient_id_still_unread; then
        clear_transient
    fi
    LAST_KNOWN_TOP_ID="$NEWEST_ID"
    emit
}

# ─── Drain bursty multi-line D-Bus output ──────────────────────────────────
# dbus-monitor emits multiple lines per logical event (method-call header,
# args, …). After the first line wakes us, consume any further lines that
# arrive within a 50 ms quiet window so we don't recompute N times for
# one notification.
drain_dbus_burst() {
    local _line
    while read -t 0.05 -u "$DBUS_FD" -r _line; do :; done
}

# ─── Cleanup ───────────────────────────────────────────────────────────────
cleanup() {
    # Clear the cache so a fresh daemon starts from empty state, not stale.
    printf '%s' '{"text":""}' > "${CACHE}.tmp.$$" 2>/dev/null && mv -f "${CACHE}.tmp.$$" "$CACHE" 2>/dev/null
    pkill -RTMIN+"$SIGNAL" waybar 2>/dev/null || true
    # Close DBus FD if open.
    exec {DBUS_FD}<&- 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# ─── Main loop ─────────────────────────────────────────────────────────────
# Subscribe to BOTH the standard Notifications interface (to see Notify
# calls) AND mako's own fr.emersion.mako interface (Dismissed,
# ModeChanged). We never parse the dbus-monitor output — events are pure
# triggers, mako's `list` / `mode` queries are the source of truth.
exec {DBUS_FD}< <(dbus-monitor --session \
    "interface='org.freedesktop.Notifications'" \
    "interface='fr.emersion.mako'" 2>/dev/null)

# Initial state — pick up notifications that arrived while the daemon was
# down, set baseline LAST_KNOWN_TOP_ID so we don't fire a transient for
# every unread that already existed.
query_mako_state
LAST_KNOWN_TOP_ID="$NEWEST_ID"
emit

while true; do
    if [[ -z $TRANSIENT_KIND ]]; then
        # No transient — block indefinitely waiting for the next D-Bus
        # event. read -u with no -t blocks until input or EOF.
        if read -u "$DBUS_FD" -r _line; then
            drain_dbus_burst
            on_dbus_event
        else
            # dbus-monitor closed — bail; systemd will restart us.
            break
        fi
    else
        # Transient active — block until either the next timer fires
        # or a D-Bus event arrives, whichever is first.
        tick=$(next_tick_seconds)
        if read -t "$tick" -u "$DBUS_FD" -r _line; then
            drain_dbus_burst
            on_dbus_event
        else
            # Timer expired — walk the state machine + re-emit.
            check_transient_timers && emit
        fi
    fi
done
