UNREAD_IDS=""
LAST_KNOWN_TOP_ID=0
LAST_UNREAD_IDS=""
# P3 profile state
ACTIVE_PROFILE="off"
ACTIVE_SILENCE_MODE="none"
ACTIVE_CRIT_PULSE=1
ACTIVE_CRIT_SOUND=1
ACTIVE_ALLOWED_CSV=""
ACTIVE_VALID_UNTIL=""
