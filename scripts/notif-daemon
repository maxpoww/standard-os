#!/usr/bin/env bash
# notif-daemon — OPTIONS notification-center spine.
#
# Subscribes to org.freedesktop.Notifications via dbus-monitor, queries
# the Rust notif-os-daemon (org.standardos.NotifOS) for authoritative
# state, and writes two atomic cache files that the custom/notif waybar
# pills render:
#   /tmp/waybar-cache/notif-bell  — bell parent pill (state + transient face)
#   /tmp/waybar-cache/notif-dnd   — DND child pill (hover-revealed)
#
# Spine spec:
#   waybar/docs/superpowers/specs/2026-06-06-notification-center-spine-design.md
# §"Pill state machine" is the authoritative behavior table.
# render_bell_for_state (below) encodes that table —
# pure function, no side effects, safe to source from tests via
# NOTIF_DAEMON_LIB_ONLY=1.
#
# Hazard checklist (from waybar/CLAUDE.md):
#   - class field is a JSON ARRAY (never space-separated string)
#   - cache writes are atomic (tmp + mv -f)
#   - RTMIN+12 fires only on real-content change (dedup at writer)
#   - no per-tick jq / awk / head / tr forks in hot paths (bash builtins)
#   - DBus FD opened ONCE with exec {FD}<…; reads via -u "$FD"
#   - light/dark adaptation: every emit reads /tmp/glass-mode fresh via
#     glass_theme() so the cache file always carries the current theme. The
#     central glass-text-daemon also rewrites our caches on mode change
#     (defense in depth); we still emit theme-correctly so a fresh arrival
#     between mode flips doesn't briefly carry the wrong class.

set -uo pipefail

# ─── glass_theme — mirror of pill.sh's pill_theme without sourcing it ────
# Reads /tmp/glass-mode and echoes "light" or "dark". Defaults to "dark" on
# any error: white text on a dark wallpaper stays visible, dark text on a
# light wallpaper disappears, so "dark" is the safe fallback.
glass_theme() {
    local m
    m=$(cat /tmp/glass-mode 2>/dev/null) || m=""
    case "$m" in light|dark) printf '%s' "$m" ;; *) printf 'dark' ;; esac
}

# ─── json_escape — escape strings for embedding in JSON values ────────────
# Notification fields arrive un-escaped from D-Bus. A single un-escaped
# quote in a title corrupts the entire cache file and waybar renders an
# empty pill. Order matters: backslash MUST be escaped BEFORE quote, or
# the inserted `\` (from `"` → `\"`) gets double-escaped by the backslash
# pass. The order in this body reflects that constraint — do not reorder.
json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# ─── pango_escape — escape strings for Pango markup ────────────────────────
# Used when a string will be wrapped in <b>...</b> or similar Pango tags in
# waybar's custom-module text. Order matters: & MUST be escaped BEFORE < and
# >, or the inserted &amp; gets re-escaped to &amp;amp; etc.
pango_escape() {
    local s="$1"
    s="${s//&/\&amp;}"
    s="${s//</\&lt;}"
    s="${s//>/\&gt;}"
    printf '%s' "$s"
}

# ─── detect_otp — extract a 4-8 digit code from notification text ──────────
# Args: summary body
# Returns: first matching code, or empty string.
#
# Rule: a 4-8 digit standalone code preceded within 40 characters by one of
# ~15 OTP keywords. Anchored to avoid false positives (prices, phone numbers,
# timestamps, package tracking). Case-insensitive keyword match via PCRE.
#
# Requires GNU grep with -P. If -P is not available, returns empty (silently
# disables OTP detection rather than producing false output).
detect_otp() {
    local summary="$1" body="$2"
    local combined="$summary $body"
    # Sanity-check PCRE availability — `grep -P ''` on GNU grep succeeds with
    # no input and exit 1 (no match). On busybox grep it fails with exit 2.
    grep -P '' /dev/null 2>/dev/null
    (( $? > 1 )) && return 0
    local keywords='code|codigo|código|codice|OTP|PIN|verification|auth|login|log-in|token|cód|MFA|2FA|one-time|one time'
    local match
    match=$(printf '%s' "$combined" \
        | grep -oP "(?i)(${keywords})[^[:digit:]]{0,40}\b\K\d{4,8}\b" 2>/dev/null \
        | head -1)
    printf '%s' "$match"
}

# ─── sound_for_state — pick canberra event ID per arrival ──────────────────
# Pure function. Returns the event id string, or empty for silent.
# DND suppression is handled in on_arrival before this is called.
#
# Args:
#   $1 urgency — 0 (low), 1 (normal), 2 (critical)
sound_for_state() {
    local urg="$1"
    if (( urg == 2 )); then
        printf 'dialog-warning'
    else
        printf 'message-new-instant'
    fi
}

# ─── transient_kind_for_state — pure ───────────────────────────────────────
# transient_kind_for_state URGENCY APP → "" | "normal" | "critical"
# (Pure function. DND suppression is handled in on_arrival before this is
# called.) The returned kind is consumed by render_bell_for_state's
# `case "$kind"`: "critical" adds opt-no + opt-pulse-orange to the
# wide-pill; "normal" falls through with no extra classes. "beat" exists
# in render_bell_for_state for a silenced-ack path that nothing currently
# emits (kept dormant in case a future quiet-mode wants it).
transient_kind_for_state() {
    local urg="$1" app="$2"
    if (( urg == 2 )); then
        printf 'critical'
    elif [[ -n "$app" ]]; then
        printf 'normal'
    fi
}

# ─── render_bell_for_state ──────────────────────────────────────────────────
# The bell parent pill carries ALL state: pin color at rest, transient face
# during the 5s arrival window, glyph swap encoding the active silence profile.
# Pure function.
#
# Args:
#   $1 unread        — total unread count
#   $2 critical      — critical unread count
#   $3 silence_mode  — 'none' | 'transient' | 'all-but-critical-silent' |
#                      'non-allowed' | 'all'  (P3: replaces dnd_on 0/1)
#   $4 kind          — '' | 'normal' | 'critical'  (transient kind)
#   $5 app           — origin app (when kind != '')
#   $6 title         — summary (when kind != '')
#   $7 body          — body (tooltip text when transient)
#   $8 otp_code      — extracted OTP code string, or empty (P2)
#   $9 otp_copied    — 0 or 1; appends ' · copied' to text when 1 (P2)
render_bell_for_state() {
    local unread="${1:-0}" critical="${2:-0}" silence_mode="${3:-none}"
    local kind="${4:-}" app="${5:-}" title="${6:-}" body="${7:-}"
    local otp_code="${8:-}" otp_copied="${9:-0}"

    # Glyph: FA bell (U+F0F3 \xef\x83\xb3) when silenceMode=none,
    # FA solid bell-slash (U+F1F7 \xef\x87\xb7) otherwise.
    local bell
    if [[ $silence_mode == "none" ]]; then
        bell=$'\xef\x83\xb3'
    else
        bell=$'\xef\x87\xb7'
    fi

    local -a classes=("opt-pill" "$(glass_theme)")

    # Beat: short bell-arrival ack used when transient is silenced
    # (Sleep/Work/Gaming/Media). Renders the rest face (bell glyph + unread
    # state classes) plus opt-beat for the 450ms green-tint pulse animation.
    # Distinct from the wide-pill kinds because the user hasn't asked to
    # see content — they only want to know something arrived.
    if [[ $kind == "beat" ]]; then
        classes+=("opt-beat")
        if (( unread > 0 )); then
            if (( critical > 0 )); then
                classes+=("opt-pin-orange")
            else
                classes+=("opt-yes")
            fi
        fi
        local classes_json
        _classes_json classes_json "${classes[@]}"
        printf '{"text":"%s","class":%s,"tooltip":"Notifications","otp_code":""}' \
            "$bell" "$classes_json"
        return 0
    fi

    if [[ -n $kind ]]; then
        case "$kind" in
            critical)
                classes+=("opt-no" "opt-pulse-orange")
                ;;
            normal|*)
                ;;
        esac
        [[ -n $otp_code ]] && classes+=("opt-glow-green")
        # NB: opt-pushed dropped from P3. Profile-active signal lives in the
        # glyph swap above (none → bell, anything else → bell-slash).

        local classes_json
        _classes_json classes_json "${classes[@]}"

        # Self-contained escaping: pango_escape BEFORE the <b>...</b> wrap so
        # raw user-supplied text can't inject markup; then json_escape the
        # composed text so the JSON itself stays valid.
        local app_pango title_pango body_esc otp_code_esc
        app_pango=$(pango_escape "$app")
        title_pango=$(pango_escape "$title")
        body_esc=$(json_escape "$body")
        otp_code_esc=$(json_escape "$otp_code")

        local app_esc title_esc text_body
        app_esc=$(json_escape "$app_pango")
        title_esc=$(json_escape "$title_pango")
        text_body="<b>${app_esc}</b> · ${title_esc}"
        if (( otp_copied == 1 )); then
            text_body+=" · copied"
        fi
        printf '{"text":"%s","class":%s,"tooltip":"%s","otp_code":"%s"}' \
            "$text_body" "$classes_json" "$body_esc" "$otp_code_esc"
        return 0
    fi

    # Rest face: glyph + state color. Per the O_S palette pairing —
    # blue = primary "active/healthy" state — an unread non-critical noti
    # is "active/new" so the bell takes opt-yes (blue). Critical escalates
    # to opt-pin-orange (the "needs attention" secondary).
    if (( unread > 0 )); then
        if (( critical > 0 )); then
            classes+=("opt-pin-orange")
        else
            classes+=("opt-yes")
        fi
    fi
    # No opt-pushed on rest either.

    local classes_json
    _classes_json classes_json "${classes[@]}"
    printf '{"text":"%s","class":%s,"tooltip":"Notifications","otp_code":""}' \
        "$bell" "$classes_json"
}

# ─── render_action_for_state (P2) ──────────────────────────────────────────
# One action child pill. Pure function.
#
# Args:
#   $1 key   — action key (passed to org.standardos.NotifOS.InvokeAction)
#   $2 label — display text (the action label declared by the app)
#
# The `key` field is a project-internal extension; waybar ignores it but
# notif-click reads it to know which action to invoke.
render_action_for_state() {
    local key="$1" label="$2"
    local label_esc key_esc
    label_esc=$(json_escape "$label")
    key_esc=$(json_escape "$key")
    printf '{"text":"%s","class":["opt-pill-child","%s","opt-yes"],"tooltip":"%s","key":"%s"}' \
        "$label_esc" "$(glass_theme)" "$label_esc" "$key_esc"
}

# ─── render_dismiss_for_state — Dismiss(X) child pill ──────────────────────
# Pure function. Reads UNREAD_COUNT global + DND_STATE_FILE presence. Emits
# the X glyph as a child pill when DND is OFF and there is at least one
# unread; otherwise emits the empty-class collapse pattern per Standard-OS's
# no-op-options rule.
render_dismiss_for_state() {
    local theme classes
    if [[ -e "$DND_STATE_FILE" ]] || (( UNREAD_COUNT == 0 )); then
        printf '{"text":"","class":["empty"]}'
        return 0
    fi
    theme="$(glass_theme)"
    _classes_json classes "opt-pill-child" "$theme"
    #  is FA times (U+F00D) — same Nerd Font set used elsewhere.
    printf '{"text":"\xef\x80\x8d","class":%s,"tooltip":"Dismiss all unread"}' "$classes"
}

# ─── render_dnd_for_state — DND pill (child when off, parent when on) ──────
# Pure function. Reads DND_STATE_FILE presence + UNREAD_COUNT global.
# DND off (default): child surface, bell-slash glyph, no state classes.
# DND on:            parent surface, bell-slash glyph, opt-breathe always,
#                    opt-yes compose if unread (blue surface + breathing).
render_dnd_for_state() {
    local theme classes tooltip
    theme="$(glass_theme)"
    if [[ -e "$DND_STATE_FILE" ]]; then
        # Parent mode.
        if (( UNREAD_COUNT > 0 )); then
            _classes_json classes "opt-pill" "$theme" "opt-breathe" "opt-yes"
        else
            _classes_json classes "opt-pill" "$theme" "opt-breathe"
        fi
        tooltip="DND on — click to resume notifications"
    else
        # Child mode.
        _classes_json classes "opt-pill-child" "$theme"
        tooltip="Stop notifications"
    fi
    printf '{"text":"\xef\x87\xb7","class":%s,"tooltip":"%s"}' "$classes" "$tooltip"
}

# ─── _classes_json VAR <class>... ──────────────────────────────────────────
# Builds a JSON array literal from positional class args, writes result to VAR
# via printf -v (no subshell fork). Defensively escapes " and \ in each class
# name so future external inputs (per-app classes from silencedApps, etc.)
# cannot produce malformed JSON. Internal classes (opt-pill, opt-pushed, ...)
# never need this, but the cost is zero and the safety net is permanent.
_classes_json() {
    local __var="$1"; shift
    local out="[" first=1 c esc
    for c in "$@"; do
        esc="${c//\\/\\\\}"
        esc="${esc//\"/\\\"}"
        if (( first )); then
            out+="\"$esc\""
            first=0
        else
            out+=",\"$esc\""
        fi
    done
    out+="]"
    printf -v "$__var" '%s' "$out"
}

# ─── Library-only short-circuit ────────────────────────────────────────────
if [[ "${NOTIF_DAEMON_LIB_ONLY:-0}" == "1" ]]; then
    return 0 2>/dev/null || exit 0
fi

# ─── Configuration ─────────────────────────────────────────────────────────
CACHE_BELL="${NOTIF_CACHE_BELL:-/tmp/waybar-cache/notif-bell}"
DND_STATE_FILE="${NOTIF_DND_FILE:-$HOME/.local/share/standard-os/notif-dnd}"
CACHE_DND="${NOTIF_CACHE_DND:-/tmp/waybar-cache/notif-dnd}"
CACHE_DISMISS="${NOTIF_CACHE_DISMISS:-/tmp/waybar-cache/notif-dismiss}"
SIGNAL="${NOTIF_SIGNAL:-12}"
TRANSIENT_MS="${NOTIF_TRANSIENT_MS:-5000}"
JOURNAL_PATH="${NOTIF_JOURNAL:-$HOME/.local/share/standard-os/notif-history.jsonl}"
JOURNAL_LIMIT="${NOTIF_JOURNAL_LIMIT:-200}"

# Source the journal lib. The Nix module installs it in the lib/ subdir next to
# the daemon binary; dev runs from the source tree have multiple fallback paths.
LIB_DIR=""
for candidate in "${NOTIF_LIB_DIR:-}" \
                 "$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/lib" \
                 "$(cd "$(dirname "$(readlink -f "$0")")/../scripts/lib" 2>/dev/null && pwd)" \
                 "/etc/nixos/home/scripts/lib"; do
    [[ -z $candidate ]] && continue
    if [[ -f "$candidate/notif-journal.sh" ]]; then
        LIB_DIR="$candidate"
        break
    fi
done
if [[ -z $LIB_DIR ]]; then
    printf 'notif-daemon: lib dir not found (tried NOTIF_LIB_DIR, $HERE/lib, …)\n' >&2
    exit 1
fi
# shellcheck source=lib/notif-journal.sh
source "$LIB_DIR/notif-journal.sh"

mkdir -p "$(dirname "$CACHE_BELL")" "$(dirname "$CACHE_DND")" "$(dirname "$JOURNAL_PATH")"

# ─── State variables ───────────────────────────────────────────────────────
UNREAD_COUNT=0
CRITICAL_COUNT=0
UNREAD_IDS=""
LAST_KNOWN_TOP_ID=0
LAST_UNREAD_IDS=""
LAST_SOUND_AT=0
TRANSIENT_KIND=""
TRANSIENT_ID=0
TRANSIENT_APP=""
TRANSIENT_TITLE=""
TRANSIENT_BODY=""
TRANSIENT_START=0
LAST_BELL_RENDERED=""
LAST_DND_RENDERED=""
LAST_DISMISS_RENDERED=""
# P2 state
TRANSIENT_OTP_CODE=""              # extracted OTP code (empty when no match)
TRANSIENT_OTP_COPIED=0             # 1 during the 500ms post-click hold
declare -a TRANSIENT_ACTIONS=()    # array of "key:label" pairs (max 3 used)
LAST_ACTION_1_RENDERED=""
LAST_ACTION_2_RENDERED=""
LAST_ACTION_3_RENDERED=""
USR2_PENDING=0

# ─── notif-os-daemon D-Bus interrogation ───────────────────────────────────
# Function name kept as `query_mako_state` to avoid touching every call site;
# it talks to org.standardos.NotifOS now, not mako. Rename in a future pass.
query_mako_state() {
    # Queries org.standardos.NotifOS.ListNotifications, which returns a JSON
    # STRING (not D-Bus structs) shaped as a flat array of notif objects:
    #   [{id, app, summary, body, urgency, actions:[[k,l],...], sender_pid,
    #     source_window, ts}, ...]
    # busctl wraps the string in `s "..."` with inner quotes escaped — we
    # strip the leading `s "` (jq's .data[0]) and unescape via jq -r.
    local arr
    arr=$(busctl --user --json=short call \
        org.standardos.NotifOS /org/standardos/NotifOS \
        org.standardos.NotifOS ListNotifications 2>/dev/null \
        | jq -r '.data[0]? // "[]"' 2>/dev/null) || arr=""
    if [[ -z $arr || $arr == "null" || $arr == "[]" ]]; then
        UNREAD_COUNT=0; CRITICAL_COUNT=0; UNREAD_IDS=""
        NEWEST_ID=0; NEWEST_URG=1
        NEWEST_APP=""; NEWEST_SUMMARY=""; NEWEST_BODY=""
        NEWEST_ACTIONS_JSON='[]'
        return
    fi
    UNREAD_COUNT=$(printf '%s' "$arr" | jq -r 'length' 2>/dev/null) || UNREAD_COUNT=0
    CRITICAL_COUNT=$(printf '%s' "$arr" | jq -r '[.[] | select(.urgency == 2)] | length' 2>/dev/null) || CRITICAL_COUNT=0
    UNREAD_IDS=$(printf '%s' "$arr" | jq -r '[.[].id] | join(" ")' 2>/dev/null) || UNREAD_IDS=""
    NEWEST_ID=$(printf '%s' "$arr" | jq -r '[.[].id] | max // 0' 2>/dev/null) || NEWEST_ID=0
    NEWEST_URG=$(printf '%s' "$arr" | jq -r --argjson id "$NEWEST_ID" '[.[] | select(.id == $id)][0].urgency // 1' 2>/dev/null) || NEWEST_URG=1
    NEWEST_APP=$(printf '%s' "$arr" | jq -r --argjson id "$NEWEST_ID" '[.[] | select(.id == $id)][0].app // ""' 2>/dev/null) || NEWEST_APP=""
    NEWEST_SUMMARY=$(printf '%s' "$arr" | jq -r --argjson id "$NEWEST_ID" '[.[] | select(.id == $id)][0].summary // ""' 2>/dev/null) || NEWEST_SUMMARY=""
    NEWEST_BODY=$(printf '%s' "$arr" | jq -r --argjson id "$NEWEST_ID" '[.[] | select(.id == $id)][0].body // ""' 2>/dev/null) || NEWEST_BODY=""
    # notif-os-daemon returns actions as [[key,label], ...] (array of pairs).
    # Flatten to [key, label, key, label, ...] so the existing pairwise loop
    # in on_arrival reads each cell with .[$i] / .[$i+1].
    NEWEST_ACTIONS_JSON=$(printf '%s' "$arr" | jq -c --argjson id "$NEWEST_ID" \
        '[.[] | select(.id == $id)][0].actions // [] | flatten' \
        2>/dev/null) || NEWEST_ACTIONS_JSON='[]'
    [[ -z $NEWEST_ACTIONS_JSON || $NEWEST_ACTIONS_JSON == "null" ]] && NEWEST_ACTIONS_JSON='[]'
}

# ─── Transient lifecycle ───────────────────────────────────────────────────
clear_transient() {
    TRANSIENT_KIND=""
    TRANSIENT_ID=0
    TRANSIENT_APP=""
    TRANSIENT_TITLE=""
    TRANSIENT_BODY=""
    TRANSIENT_START=0
    TRANSIENT_OTP_CODE=""
    TRANSIENT_OTP_COPIED=0
    TRANSIENT_ACTIONS=()
}

transient_id_still_unread() {
    [[ -z $TRANSIENT_KIND ]] && return 0
    (( TRANSIENT_ID == 0 )) && return 0
    local id
    for id in $UNREAD_IDS; do
        (( id == TRANSIENT_ID )) && return 0
    done
    return 1
}

on_arrival() {
    local urg="$NEWEST_URG"

    local dnd_on=0
    [[ -e "$DND_STATE_FILE" ]] && dnd_on=1

    if (( ! dnd_on )); then
        # Decide transient kind via the pure helper.
        local kind
        kind=$(transient_kind_for_state "$urg" "$NEWEST_APP")
        TRANSIENT_KIND="$kind"

        # OTP + actions only matter when there's a transient.
        if [[ -n $TRANSIENT_KIND ]]; then
            TRANSIENT_ID="$NEWEST_ID"
            TRANSIENT_APP="$NEWEST_APP"
            TRANSIENT_TITLE="$NEWEST_SUMMARY"
            TRANSIENT_BODY="$NEWEST_BODY"
            TRANSIENT_START=$(date +%s%3N)
            TRANSIENT_OTP_CODE=$(detect_otp "$NEWEST_SUMMARY" "$NEWEST_BODY")
            TRANSIENT_OTP_COPIED=0

            # Parse actions (same as P2).
            TRANSIENT_ACTIONS=()
            if [[ ${NEWEST_ACTIONS_JSON:-'[]'} != '[]' && -n ${NEWEST_ACTIONS_JSON:-} ]]; then
                local pair_count=0
                local arr_len
                arr_len=$(jq -r 'length' <<< "$NEWEST_ACTIONS_JSON" 2>/dev/null) || arr_len=0
                local i=0
                while (( i + 1 < arr_len && pair_count < 3 )); do
                    local key_i label_i
                    key_i=$(jq -r ".[$i]" <<< "$NEWEST_ACTIONS_JSON" 2>/dev/null) || key_i=""
                    label_i=$(jq -r ".[$((i+1))]" <<< "$NEWEST_ACTIONS_JSON" 2>/dev/null) || label_i=""
                    TRANSIENT_ACTIONS+=("${key_i}:${label_i}")
                    pair_count=$((pair_count + 1))
                    i=$((i + 2))
                done
            fi
        fi
    else
        TRANSIENT_KIND=""
    fi

    if (( ! dnd_on )); then
        # Sound playback, rate-limited at 500ms.
        local sound_id
        sound_id=$(sound_for_state "$urg")
        if [[ -n $sound_id ]]; then
            local now_ms
            now_ms=$(date +%s%3N)
            if (( now_ms - LAST_SOUND_AT >= 500 )); then
                canberra-gtk-play -i "$sound_id" 2>/dev/null & disown
                LAST_SOUND_AT="$now_ms"
            fi
        fi
    fi
}

# Returns 0 if state changed (caller should re-render), 1 otherwise.
check_transient_timer() {
    [[ -z $TRANSIENT_KIND ]] && return 1
    local now elapsed limit
    now=$(date +%s%3N)
    elapsed=$(( now - TRANSIENT_START ))
    if (( TRANSIENT_OTP_COPIED == 1 )); then
        limit=500   # 500ms post-click hold for the "copied" suffix
    elif [[ $TRANSIENT_KIND == "beat" ]]; then
        limit=700   # one-shot 600ms heartbeat + small buffer
    else
        limit="$TRANSIENT_MS"
    fi
    if (( elapsed >= limit )); then
        # If we were in the OTP-copied hold, dismiss the notification AS the
        # transient collapses (notif-os-daemon emits NotificationClosed,
        # which triggers a fresh on_dbus_event → query_mako_state → emit;
        # the bell returns to rest carrying whatever pin color the remaining
        # unread state implies).
        if (( TRANSIENT_OTP_COPIED == 1 )) && (( TRANSIENT_ID > 0 )); then
            busctl --user call \
                org.freedesktop.Notifications /org/freedesktop/Notifications \
                org.freedesktop.Notifications CloseNotification "u" "$TRANSIENT_ID" \
                2>/dev/null || true
        fi
        clear_transient
        return 0
    fi
    return 1
}

# Seconds (fractional) until the next 5s timer fires; sentinel 3600 when none.
next_tick_seconds() {
    [[ -z $TRANSIENT_KIND ]] && { printf '3600'; return; }
    local now elapsed limit remaining_ms
    now=$(date +%s%3N)
    elapsed=$(( now - TRANSIENT_START ))
    if [[ $TRANSIENT_KIND == "beat" ]]; then
        limit=700
    else
        limit="$TRANSIENT_MS"
    fi
    remaining_ms=$(( limit - elapsed ))
    (( remaining_ms < 100 )) && remaining_ms=100
    awk -v ms="$remaining_ms" 'BEGIN{ printf "%.3f", ms/1000 }'
}

# ─── Cache writes with dedup + waybar signal ───────────────────────────────
write_if_changed() {
    local path="$1" content="$2" last_var="$3"
    local last="${!last_var}"
    [[ "$content" == "$last" ]] && return 1
    printf -v "$last_var" '%s' "$content"
    local tmp="${path}.tmp.$$"
    printf '%s' "$content" > "$tmp" && mv -f "$tmp" "$path"
    return 0
}

# Write notif-action-{1,2,3} caches based on the current TRANSIENT_ACTIONS
# array. Slot N is the (N-1)th action; missing slots emit {"text":""} so the
# child pills collapse to .empty in waybar.
emit_action_caches() {
    local i changed_any=0
    for i in 1 2 3; do
        local cache="/tmp/waybar-cache/notif-action-$i"
        local last_var="LAST_ACTION_${i}_RENDERED"
        local idx=$((i - 1))
        local content
        if [[ -n $TRANSIENT_KIND ]] && (( idx < ${#TRANSIENT_ACTIONS[@]} )); then
            local pair="${TRANSIENT_ACTIONS[$idx]}"
            local key="${pair%%:*}"
            local label="${pair#*:}"
            content=$(render_action_for_state "$key" "$label")
        else
            content='{"text":""}'
        fi
        write_if_changed "$cache" "$content" "$last_var" && changed_any=1
    done
    return $changed_any
}

emit() {
    query_mako_state
    local bell_json
    bell_json=$(render_bell_for_state \
        "$UNREAD_COUNT" "$CRITICAL_COUNT" "none" \
        "$TRANSIENT_KIND" "$TRANSIENT_APP" "$TRANSIENT_TITLE" "$TRANSIENT_BODY" \
        "$TRANSIENT_OTP_CODE" "$TRANSIENT_OTP_COPIED")

    local dnd_json
    dnd_json=$(render_dnd_for_state)
    local changed=0
    write_if_changed "$CACHE_BELL" "$bell_json" LAST_BELL_RENDERED && changed=1
    write_if_changed "$CACHE_DND" "$dnd_json" LAST_DND_RENDERED && changed=1
    local dismiss_json
    dismiss_json=$(render_dismiss_for_state)
    write_if_changed "$CACHE_DISMISS" "$dismiss_json" LAST_DISMISS_RENDERED && changed=1
    emit_action_caches
    (( $? == 1 )) && changed=1
    if (( changed )); then
        pkill -RTMIN+"$SIGNAL" waybar 2>/dev/null || true
    fi
}

# ─── D-Bus event handler ───────────────────────────────────────────────────
on_dbus_event() {
    # Small settle delay before we query notif-os-daemon. dbus-monitor sees
    # method-call traffic; the daemon stores synchronously inside Notify so
    # in practice the store is already updated, but 50 ms absorbs any
    # tokio scheduling slop without being user-perceptible.
    sleep 0.05
    local prev_top_id="$LAST_KNOWN_TOP_ID"
    query_mako_state
    if (( NEWEST_ID > prev_top_id )); then
        on_arrival
        # Journal append + prune + source_window capture happen inside
        # notif-os-daemon (Rust) at Notify time. We used to duplicate them
        # here from before the cutover; now the daemon is the sole writer.
    fi
    # Journal: mark anything dismissed since last query. The Rust daemon
    # never writes dismissed_at, so this responsibility stays in bash.
    local id
    for id in $LAST_UNREAD_IDS; do
        if ! grep -qE "(^| )$id( |$)" <<< "$UNREAD_IDS"; then
            journal_mark_dismissed "$JOURNAL_PATH" "$id" "$(date -Iseconds)"
        fi
    done
    LAST_UNREAD_IDS="$UNREAD_IDS"
    if ! transient_id_still_unread; then
        clear_transient
    fi
    LAST_KNOWN_TOP_ID="$NEWEST_ID"
    emit
}

drain_dbus_burst() {
    local _line
    while read -t 0.05 -u "$DBUS_FD" -r _line; do :; done
}

# ─── SIGUSR1: DND toggle notification ────────────────────────────────────
# notif-click writes the DND state file then signals us via
# systemctl --user kill --kill-who=main -s SIGUSR1 so we re-render
# the DND child pill. Without this, DND state in the bar would lag
# until the next Notify event triggered on_dbus_event.
on_user_signal() {
    USR1_PENDING=1
}
trap on_user_signal USR1
on_user_signal_2() {
    USR2_PENDING=1
}
trap on_user_signal_2 USR2
USR1_PENDING=0

# ─── Cleanup ───────────────────────────────────────────────────────────────
cleanup() {
    printf '%s' '{"text":""}' > "${CACHE_BELL}.tmp.$$" 2>/dev/null && mv -f "${CACHE_BELL}.tmp.$$" "$CACHE_BELL" 2>/dev/null
    printf '%s' '{"text":""}' > "${CACHE_DND}.tmp.$$" 2>/dev/null && mv -f "${CACHE_DND}.tmp.$$" "$CACHE_DND" 2>/dev/null
    printf '%s' '{"text":""}' > "${CACHE_DISMISS}.tmp.$$" 2>/dev/null && mv -f "${CACHE_DISMISS}.tmp.$$" "$CACHE_DISMISS" 2>/dev/null
    pkill -RTMIN+"$SIGNAL" waybar 2>/dev/null || true
    exec {DBUS_FD}<&- 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# ─── Main loop ─────────────────────────────────────────────────────────────
exec {DBUS_FD}< <(dbus-monitor --session \
    "interface='org.freedesktop.Notifications'" 2>/dev/null)

query_mako_state
LAST_KNOWN_TOP_ID="$NEWEST_ID"
LAST_UNREAD_IDS="$UNREAD_IDS"
emit

while true; do
    # Drain any USR1 that may have been queued while we were NOT blocked on
    # read (e.g. inside drain_dbus_burst). Now used for DND toggle re-emit.
    if (( USR1_PENDING )); then
        USR1_PENDING=0
        sleep 0.05   # filesystem sync window — same reason as before
        emit
    fi
    # Drain the OTP-clicked rendezvous. SIGUSR2 from notif-click sets
    # USR2_PENDING; but bash signal traps fire in whatever subshell happens
    # to be running at signal-delivery time, and $() command substitutions
    # eat the variable update (see same issue with USR1_PENDING). We poll
    # the rendezvous file existence on every loop iteration to make the
    # transition reliable; SIGUSR2 just wakes the read sooner.
    if (( USR2_PENDING )) || [[ -f /tmp/notif-otp-clicked ]]; then
        USR2_PENDING=0
        if [[ -f /tmp/notif-otp-clicked ]]; then
            _clicked_id=$(cat /tmp/notif-otp-clicked 2>/dev/null)
            rm -f /tmp/notif-otp-clicked
            if [[ -n $_clicked_id && -n $TRANSIENT_KIND && $_clicked_id == "$TRANSIENT_ID" ]]; then
                TRANSIENT_OTP_COPIED=1
                # Reset the 5s timer to use as a 500ms "copied" hold.
                TRANSIENT_START=$(date +%s%3N)
                emit
            fi
        fi
    fi
    # Cap read timeout so the top-of-loop drains (USR1 DND poll, USR2 OTP
    # rendezvous file poll) run frequently even mid-transient. Bash signal
    # traps fire in whatever subshell is active at signal-delivery time;
    # if that subshell is a $() command-substitution, the *_PENDING flag
    # update is silently lost. The file-existence poll is the reliable
    # fallback, but it only runs once per loop iteration.
    # - 0.5s during OTP-copied (need to fire the 500ms timer accurately)
    # - 0.5s during transient (rendezvous file caught within 0.5s of click)
    # - 1s idle
    if [[ -z $TRANSIENT_KIND ]]; then
        tick=1
    elif (( TRANSIENT_OTP_COPIED == 1 )); then
        tick=0.1
    else
        # Cap next_tick_seconds at 0.5s for responsive polling.
        raw_tick=$(next_tick_seconds)
        if awk -v r="$raw_tick" 'BEGIN{exit !(r>0.5)}'; then
            tick=0.5
        else
            tick="$raw_tick"
        fi
    fi
    # `read -t` exit codes:
    #   0     → got a line
    #   >128  → timeout (no input within $tick)
    #   1     → EOF (dbus-monitor died — systemd will restart us)
    read -t "$tick" -u "$DBUS_FD" -r _line
    rc=$?
    if (( rc == 0 )); then
        drain_dbus_burst
        on_dbus_event
    elif (( USR1_PENDING )); then
        USR1_PENDING=0
        sleep 0.05   # filesystem sync window — same reason as before
        emit
    elif (( rc == 1 )); then
        # Genuine EOF on the dbus-monitor pipe — exit so systemd respawns us.
        break
    elif [[ -z $TRANSIENT_KIND ]]; then
        # Idle 1-second tick: re-emit in case DND state changed.
        emit
    elif [[ -n $TRANSIENT_KIND ]]; then
        check_transient_timer && emit
    fi
    # else: 1-second idle tick with nothing pending — loop and re-read.
done
