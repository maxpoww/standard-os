#!/usr/bin/env bash
# canvas-panic — emergency dismiss for the StandardOS Dashboard.
#
# Bound to Super+Shift+ESC at the default submap level AND inside the
# canvas-open submap so it works no matter what state the keyboard is
# in.
#
# Strategy (mirrors canvas-close's tiers but skips the "verify
# gracefully" step — panic is invoked when graceful is already known
# to be broken):
#
#   1. Reset Hyprland submap (recovers the keyboard immediately,
#      independent of eww).
#   2. Try a graceful eww close (1 s timeout).
#   3. Verify the dashboard window is gone via active-windows. If
#      verification succeeds, done.
#   4. Otherwise hard-restart the standardos-canvas.service unit.
#      RestartSec=1 + Restart=always means a fresh daemon is back
#      within ~1 s with no wedged state, no stuck window.
#
# Previously (pre-2026-06-26) this script gated the restart on
# `! eww ping` succeeding within 1 s. That was wrong: the eww daemon's
# IPC thread can answer ping fine while its UI thread is wedged
# processing an error queue. Panic would then skip the restart and
# the user stayed trapped. Now the gate is the close VERIFICATION —
# if we can't prove the window is gone, restart unconditionally.

set -u

timeout 1 hyprctl dispatch submap reset >/dev/null 2>&1 || true
timeout 1 eww close dashboard >/dev/null 2>&1 || true

verified_closed=0
if windows=$(timeout 1 eww active-windows 2>/dev/null); then
    if ! grep -q '^dashboard' <<<"$windows"; then
        verified_closed=1
    fi
fi

if [ "$verified_closed" -eq 0 ]; then
    systemctl --user restart standardos-canvas.service >/dev/null 2>&1 || true
fi

exit 0
