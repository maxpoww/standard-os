#!/usr/bin/env bash
# canvas-panic — emergency dismiss for the StandardOS Dashboard.
#
# Bound to Super+Shift+ESC at the default submap level AND inside the
# canvas-open submap so it works no matter what state the keyboard is
# in.
#
# Strategy (mirrors canvas-close's tiers but skips the "verify
# gracefully" step — panic is invoked when graceful is already known
# to be broken):
#
#   1. Reset Hyprland submap (recovers the keyboard immediately,
#      independent of eww).
#   2. Try a graceful eww close (1 s timeout).
#   3. Verify the dashboard surface is gone by inspecting Hyprland's
#      layer-shell list (NOT eww active-windows — see canvas-close
#      for the full rationale). If verification succeeds, done.
#   4. Otherwise hard-restart the standardos-canvas.service unit.
#      RestartSec=1 + Restart=always means a fresh daemon is back
#      within ~1 s with no wedged state, no stuck surface.
#
# Two earlier verify signals were rejected in the same 2026-06-25
# investigation:
#   - `eww ping` succeeding: the IPC thread answers fine while the
#     UI thread is wedged on an error queue — panic would skip the
#     restart and the user stayed trapped.
#   - `eww active-windows` reporting empty: when `eww open` hangs
#     mid-handshake, the layer-shell surface is up but eww never
#     registers the window — active-windows lies "clean" while the
#     dashboard is visibly still on screen.
# Hyprland's layer list is the only signal grounded in what the user
# actually sees.

set -u

timeout 1 hyprctl dispatch submap reset >/dev/null 2>&1 || true
timeout 1 eww close dashboard >/dev/null 2>&1 || true

verified_closed=0
if layers=$(timeout 1 hyprctl layers 2>/dev/null); then
    overlay=$(awk '
        /Layer level 3 \(overlay\):/ { flag=1; next }
        /Layer level [0-9]+ \(/      { flag=0 }
        flag
    ' <<<"$layers")
    if ! grep -q 'namespace: gtk-layer-shell' <<<"$overlay"; then
        verified_closed=1
    fi
fi

if [ "$verified_closed" -eq 0 ]; then
    systemctl --user restart standardos-canvas.service >/dev/null 2>&1 || true
fi

exit 0
