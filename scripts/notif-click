#!/usr/bin/env bash
# notif-click — waybar on-click dispatcher for the OPTIONS notif pill.
#
# Called by custom/notif's on-click / on-click-right handlers in
# waybar/config.jsonc. The decision logic (notif_click_decide) is a pure
# function tested by tests/notif-click-test.sh; this script wraps it with
# the actual invocation through notif-os-daemon (org.standardos.NotifOS).
#
# Spine spec:
#   waybar/docs/superpowers/specs/2026-06-06-notification-center-spine-design.md
# §"Click handling" defines the rest-vs-transient detection and the interim
# rest-face = dismiss-all behavior (the drawer follow-up spec replaces this).

set -uo pipefail

CACHE="${NOTIF_CACHE:-/tmp/waybar-cache/notif-bell}"

# ─── Resolve lib path + source notif-os.sh ─────────────────────────────────
# NOTIF_LIB_DIR is exported by mkScript when packaged. Dev-launch (running
# from the source tree) falls back to the in-repo lib dir. The pure
# decision function (notif_click_decide) is exercised by the test suite
# with NOTIF_CLICK_LIB_ONLY=1 — that path returns before reaching any
# helper that needs notif-os.sh, so a missing lib here is non-fatal.
_lib=""
for _c in "${NOTIF_LIB_DIR:-}" "/etc/nixos/home/scripts/lib"; do
    [[ -z $_c ]] && continue
    if [[ -f "$_c/notif-os.sh" ]]; then _lib="$_c"; break; fi
done
if [[ -n $_lib ]]; then
    # shellcheck source=lib/notif-os.sh
    source "$_lib/notif-os.sh"
fi
unset _lib _c

# Helper: max id currently in the notif-os-daemon store, or empty.
_latest_id() {
    _notif_list_raw | jq -r '[.[].id] | max // empty' 2>/dev/null
}

# ─── Pure decision function ────────────────────────────────────────────────
# notif_click_decide ACTION CACHE_CONTENT → one of (current outputs):
#   bell  on transient  → "invoke-and-dismiss"  (P1; runtime wired in task 7)
#   bell  on transient + otp_code → "invoke-otp"   (P2; copy + 500ms + dismiss)
#   bell  on rest       → "open-rofi"           (P1; runtime wired in task 7)
#   bell  on empty/bad  → "noop"
#   invoke on transient → "invoke-latest"       (legacy spine; removed task 7)
#   invoke on rest      → "dismiss-all"         (legacy spine; removed task 7)
#   invoke on empty/bad → "noop"
#   action on populated cache    → "invoke-action" (P2; NotifOS InvokeAction <id> <key>)
#   action on empty/missing key  → "noop"
#   drawer / unknown    → "noop"
#
# Transient detection: the daemon's render functions build transient text as
# `<app> · <title>` (P1) or `<bell> <app> · <title>` (spine legacy). The
# literal " · " separator appears only in transient states; rest faces are
# the bell glyph alone, empty face is "text":"". Matching on " · " is the
# cheapest reliable signal without parsing the class array.
notif_click_decide() {
    local action="$1"
    local cache_content="$2"

    case "$action" in
        bell)
            # The bell pill: distinguish rest from transient by the ' · '
            # separator the daemon writes ONLY in transient text.
            if [[ -z $cache_content || $cache_content == '{"text":""}' ]]; then
                printf 'noop'
                return 0
            fi
            if [[ $cache_content != '{"text":'* ]]; then
                printf 'noop'
                return 0
            fi
            # P2: if cache carries a non-empty otp_code, the click should run
            # the OTP-copy flow instead of the standard invoke+dismiss.
            local otp
            otp=$(printf '%s' "$cache_content" | jq -r '.otp_code // empty' 2>/dev/null)
            if [[ -n $otp ]]; then
                printf 'invoke-otp'
                return 0
            fi
            if [[ $cache_content == *' · '* ]]; then
                printf 'invoke-and-dismiss'
            else
                printf 'open-rofi'
            fi
            ;;
        dnd)
            # Pure toggle — cache is ignored. The action runner below
            # creates / removes ~/.local/share/standard-os/notif-dnd
            # and signals the bash notif-daemon to re-emit the pill cache.
            printf 'toggle-dnd'
            ;;
        dismiss)
            # Dismiss-all — fires mako_dismiss_all in the action runner.
            # Cache content is ignored. The runner case "dismiss-all" is
            # the existing legacy branch (kept around for waybar custom
            # 'invoke' on rest face); we reuse it here.
            printf 'dismiss-all'
            ;;
        action)
            # Action click: cache must carry a non-empty `key` field.
            local key
            key=$(printf '%s' "$cache_content" | jq -r '.key // empty' 2>/dev/null)
            if [[ -n $key ]]; then
                printf 'invoke-action'
            else
                printf 'noop'
            fi
            ;;
        invoke|drawer)
            # Legacy subcommands (spine spec). Kept until task 7 cleans up
            # the live wiring; preserves existing test coverage in the
            # meantime. Same decision table as before.
            case "$action" in
                invoke)
                    if [[ -z $cache_content || $cache_content == '{"text":""}' ]]; then
                        printf 'noop'; return 0
                    fi
                    if [[ $cache_content != '{"text":'* ]]; then
                        printf 'noop'; return 0
                    fi
                    if [[ $cache_content == *' · '* ]]; then
                        printf 'invoke-latest'
                    else
                        printf 'dismiss-all'
                    fi
                    ;;
                drawer)
                    printf 'noop'
                    ;;
            esac
            ;;
        *)
            # Unknown action — defensive noop.
            printf 'noop'
            ;;
    esac
}

# ─── Library-only short-circuit (for tests) ────────────────────────────────
if [[ "${NOTIF_CLICK_LIB_ONLY:-0}" == "1" ]]; then
    return 0 2>/dev/null || exit 0
fi

# ─── Action runner ─────────────────────────────────────────────────────────
# action <N> subcommand: redirect CACHE to /tmp/waybar-cache/notif-action-N
# and rewrite $1 so notif_click_decide sees the canonical "action" subcommand.
if [[ "${1:-}" == "action" && -n "${2:-}" ]]; then
    N="$2"
    case "$N" in
        1|2|3)
            CACHE="${NOTIF_ACTION_CACHE:-/tmp/waybar-cache/notif-action-$N}"
            set -- action
            ;;
        *)
            # Unknown N — fall through to the default 'invoke' which will
            # decide to noop on the bell-cache's content.
            ;;
    esac
fi
action="${1:-invoke}"
cache_content=$(cat "$CACHE" 2>/dev/null || true)
decision=$(notif_click_decide "$action" "$cache_content")

case "$decision" in
    invoke-and-dismiss)
        # Wide-pill click → full View semantics (not just default-action +
        # dismiss). notif-menu view-latest does: invoke default action if
        # declared, focus the source window via hyprctl, dismiss when
        # either fired, honest fallback notif otherwise. Decision string
        # is kept as "invoke-and-dismiss" to avoid churning the test
        # fixtures; rename to "view-latest" in a future sweep.
        exec notif-menu view-latest
        ;;
    invoke-otp)
        # P2: extract the OTP code from the bell cache, copy via wl-copy,
        # then signal the daemon to enter the 500ms "copied" hold.
        otp_code=$(jq -r '.otp_code // empty' "$CACHE" 2>/dev/null)
        if [[ -n $otp_code ]]; then
            printf '%s' "$otp_code" | wl-copy 2>/dev/null || true
            # Rendezvous file: the daemon's SIGUSR2 handler reads this ID and
            # only transitions if it matches the current TRANSIENT_ID (so a
            # stale click after rapid noti-replacement is ignored).
            latest_id=$(_latest_id)
            if [[ -n $latest_id ]]; then
                printf '%s' "$latest_id" > /tmp/notif-otp-clicked
                systemctl --user kill --kill-who=main -s SIGUSR2 notif-daemon.service 2>/dev/null || true
            fi
        fi
        ;;
    open-rofi)
        # Bell click target is notif-menu — the modern L1+L2 selector with
        # View / Copy / Snooze / Dismiss actions and source-window focus.
        # (The decision string is still "open-rofi" because it's already in
        # the test fixtures; the live target moved 2026-06-15.)
        exec notif-menu
        ;;
    invoke-action)
        # P2: read the action key from the action-N cache; the wrapper above
        # has set CACHE to /tmp/waybar-cache/notif-action-N for us.
        key=$(jq -r '.key // empty' "$CACHE" 2>/dev/null)
        if [[ -n $key ]]; then
            latest_id=$(_latest_id)
            if [[ -n $latest_id ]]; then
                # mako_invoke fires ActionInvoked + NotificationClosed for any
                # id; the explicit dismiss covers the "no such id" case where
                # the user clicked an action whose notif was just closed.
                mako_invoke "$latest_id" "$key" >/dev/null 2>&1 || true
                mako_dismiss "$latest_id" >/dev/null 2>&1 || true
            fi
        fi
        ;;
    noop)
        : ;;
    # Legacy decisions
    invoke-latest)
        latest_id=$(_latest_id)
        if [[ -n $latest_id ]]; then
            mako_invoke "$latest_id" default >/dev/null 2>&1 || true
            mako_dismiss "$latest_id" >/dev/null 2>&1 || true
        fi
        ;;
    dismiss-all)
        mako_dismiss_all
        ;;
    toggle-dnd)
        # Single state file: presence ↔ DND ON. Empty body is fine;
        # presence is the signal. SIGUSR1 wakes the daemon's main loop so
        # the DND pill cache + tooltip flip without a notif arriving.
        DND_STATE_FILE="${NOTIF_DND_FILE:-$HOME/.local/share/standard-os/notif-dnd}"
        mkdir -p "$(dirname "$DND_STATE_FILE")"
        if [[ -e "$DND_STATE_FILE" ]]; then
            rm -f "$DND_STATE_FILE"
        else
            : > "$DND_STATE_FILE"
        fi
        systemctl --user kill --kill-who=main -s SIGUSR1 notif-daemon.service 2>/dev/null || true
        ;;
esac
