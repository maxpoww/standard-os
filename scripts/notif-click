#!/usr/bin/env bash
# notif-click — waybar on-click dispatcher for the OPTIONS notif pill.
#
# Called by custom/notif's on-click / on-click-right handlers in
# waybar/config.jsonc. The decision logic (notif_click_decide) is a pure
# function tested by tests/notif-click-test.sh; this script wraps it with
# the actual makoctl invocation.
#
# Spine spec:
#   waybar/docs/superpowers/specs/2026-06-06-notification-center-spine-design.md
# §"Click handling" defines the rest-vs-transient detection and the interim
# rest-face = dismiss-all behavior (the drawer follow-up spec replaces this).

set -uo pipefail

CACHE="${NOTIF_CACHE:-/tmp/waybar-cache/notif-bell}"

# ─── Pure decision function ────────────────────────────────────────────────
# notif_click_decide ACTION CACHE_CONTENT → one of (current outputs):
#   bell  on transient  → "invoke-and-dismiss"  (P1; runtime wired in task 7)
#   bell  on transient + otp_code → "invoke-otp"   (P2; copy + 500ms + dismiss)
#   bell  on rest       → "open-rofi"           (P1; runtime wired in task 7)
#   bell  on empty/bad  → "noop"
#   dnd                 → "toggle-dnd"          (P1; runtime wired in task 7)
#   invoke on transient → "invoke-latest"       (legacy spine; removed task 7)
#   invoke on rest      → "dismiss-all"         (legacy spine; removed task 7)
#   invoke on empty/bad → "noop"
#   action on populated cache    → "invoke-action" (P2; makoctl invoke -n <id> <key>)
#   action on empty/missing key  → "noop"
#   drawer / unknown    → "noop"
#
# Transient detection: the daemon's render functions build transient text as
# `<app> · <title>` (P1) or `<bell> <app> · <title>` (spine legacy). The
# literal " · " separator appears only in transient states; rest faces are
# the bell glyph alone, empty face is "text":"". Matching on " · " is the
# cheapest reliable signal without parsing the class array.
notif_click_decide() {
    local action="$1"
    local cache_content="$2"

    case "$action" in
        bell)
            # The bell pill: distinguish rest from transient by the ' · '
            # separator the daemon writes ONLY in transient text.
            if [[ -z $cache_content || $cache_content == '{"text":""}' ]]; then
                printf 'noop'
                return 0
            fi
            if [[ $cache_content != '{"text":'* ]]; then
                printf 'noop'
                return 0
            fi
            # P2: if cache carries a non-empty otp_code, the click should run
            # the OTP-copy flow instead of the standard invoke+dismiss.
            local otp
            otp=$(printf '%s' "$cache_content" | jq -r '.otp_code // empty' 2>/dev/null)
            if [[ -n $otp ]]; then
                printf 'invoke-otp'
                return 0
            fi
            if [[ $cache_content == *' · '* ]]; then
                printf 'invoke-and-dismiss'
            else
                printf 'open-rofi'
            fi
            ;;
        dnd)
            # DND toggle is unconditional — mako handles toggle semantics.
            printf 'toggle-dnd'
            ;;
        action)
            # Action click: cache must carry a non-empty `key` field.
            local key
            key=$(printf '%s' "$cache_content" | jq -r '.key // empty' 2>/dev/null)
            if [[ -n $key ]]; then
                printf 'invoke-action'
            else
                printf 'noop'
            fi
            ;;
        invoke|drawer)
            # Legacy subcommands (spine spec). Kept until task 7 cleans up
            # the live wiring; preserves existing test coverage in the
            # meantime. Same decision table as before.
            case "$action" in
                invoke)
                    if [[ -z $cache_content || $cache_content == '{"text":""}' ]]; then
                        printf 'noop'; return 0
                    fi
                    if [[ $cache_content != '{"text":'* ]]; then
                        printf 'noop'; return 0
                    fi
                    if [[ $cache_content == *' · '* ]]; then
                        printf 'invoke-latest'
                    else
                        printf 'dismiss-all'
                    fi
                    ;;
                drawer)
                    printf 'noop'
                    ;;
            esac
            ;;
        *)
            # Unknown action — defensive noop.
            printf 'noop'
            ;;
    esac
}

# ─── Library-only short-circuit (for tests) ────────────────────────────────
if [[ "${NOTIF_CLICK_LIB_ONLY:-0}" == "1" ]]; then
    return 0 2>/dev/null || exit 0
fi

# ─── Action runner ─────────────────────────────────────────────────────────
action="${1:-invoke}"
cache_content=$(cat "$CACHE" 2>/dev/null || true)
decision=$(notif_click_decide "$action" "$cache_content")

case "$decision" in
    invoke-and-dismiss)
        # Bell transient click — invoke the notification's default action AND
        # explicitly dismiss (mako 1.10 makoctl invoke does NOT auto-dismiss
        # notifications without a registered "default" action — the common
        # case for notify-send-shaped notifications).
        latest_id=$(busctl --user --json=short call \
            org.freedesktop.Notifications /fr/emersion/Mako \
            fr.emersion.Mako ListNotifications 2>/dev/null \
            | jq -r '[.data[0][]?.id.data] | max // empty' 2>/dev/null)
        if [[ -n $latest_id ]]; then
            makoctl invoke -n "$latest_id" 2>/dev/null || true
            makoctl dismiss -n "$latest_id" 2>/dev/null || true
        fi
        ;;
    open-rofi)
        # Bell at rest — launch the notification list browser. notif-rofi is
        # packaged into PATH by the Nix module (task 8).
        exec notif-rofi
        ;;
    toggle-dnd)
        makoctl mode -t dnd 2>/dev/null || true
        # mako 1.10 does not emit a ModeChanged D-Bus signal we can subscribe
        # to, so wake notif-daemon directly to re-query the mode + re-render
        # both caches. --kill-who=main targets only the main bash process
        # (NOT the dbus-monitor child of the process substitution).
        systemctl --user kill --kill-who=main -s SIGUSR1 notif-daemon.service 2>/dev/null || true
        ;;
    noop)
        : ;;
    # Legacy decisions — kept for the duration of the transition; the live
    # config.jsonc will be updated to call only `bell` and `dnd` subcommands
    # in task 9. After that, these branches are unreachable but harmless.
    invoke-latest)
        latest_id=$(busctl --user --json=short call \
            org.freedesktop.Notifications /fr/emersion/Mako \
            fr.emersion.Mako ListNotifications 2>/dev/null \
            | jq -r '[.data[0][]?.id.data] | max // empty' 2>/dev/null)
        if [[ -n $latest_id ]]; then
            makoctl invoke -n "$latest_id" 2>/dev/null || true
            makoctl dismiss -n "$latest_id" 2>/dev/null || true
        fi
        ;;
    dismiss-all)
        makoctl dismiss --all 2>/dev/null || true
        ;;
esac
