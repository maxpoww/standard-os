#!/usr/bin/env bash
# notif-rofi — rofi launcher for the OPTIONS notification list.
#
# Composes:
#   - lib/notif-journal.sh  → persistent history reader
#   - lib/notif-rofi-format.sh → pure row formatters
#   - lib/notif-os.sh → live list + invoke/dismiss via org.standardos.NotifOS
#
# Click flow (from waybar):
#   custom/notif-bell → on-click → notif-click bell → "open-rofi" → this script.

set -uo pipefail

# ─── Resolve lib paths ─────────────────────────────────────────────────────
# When packaged via writeShellScriptBin, libs are reachable from NOTIF_LIB_DIR
# (set in the Nix wrapper). When invoked from the source tree (dev), fall back
# to a relative or absolute lookup.
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
LIB_DIR=""
for candidate in "${NOTIF_LIB_DIR:-}" "$HERE/lib" "$HERE/../scripts/lib" "/etc/nixos/home/scripts/lib"; do
    [[ -z $candidate ]] && continue
    if [[ -f "$candidate/notif-journal.sh" ]]; then
        LIB_DIR="$candidate"
        break
    fi
done
if [[ -z $LIB_DIR ]]; then
    printf 'notif-rofi: lib dir not found (tried NOTIF_LIB_DIR, $HERE/lib, …)\n' >&2
    exit 1
fi
# shellcheck source=lib/notif-journal.sh
source "$LIB_DIR/notif-journal.sh"
# shellcheck source=lib/notif-rofi-format.sh
source "$LIB_DIR/notif-rofi-format.sh"
# shellcheck source=lib/notif-os.sh
source "$LIB_DIR/notif-os.sh"

JOURNAL="${NOTIF_JOURNAL:-$HOME/.local/share/standard-os/notif-history.jsonl}"

# ─── Live unread set ───────────────────────────────────────────────────────
# Thin wrapper around notif-os.sh's mako_list_live — keeps the prior
# function name (live_unread_map) and "<id>\t<urgency>" line format that
# the rest of this script consumes.
live_unread_map() {
    mako_list_live
}

# ─── Compose the rofi-input list ───────────────────────────────────────────
build_rows() {
    # Header + actions
    printf '%s\n' "$(format_rofi_header "Actions")"
    printf '%s\n' "Dismiss all unread"

    local live_map
    live_map=$(live_unread_map)
    local unread_count=0
    if [[ -n $live_map ]]; then
        unread_count=$(printf '%s\n' "$live_map" | grep -c '^')
    fi

    if (( unread_count > 0 )); then
        printf '%s\n' "$(format_rofi_header "Unread ($unread_count)")"
        # Live entries first, newest highest-id first
        while IFS=$'\t' read -r id urgency; do
            [[ -z $id ]] && continue
            local fields app summary ts
            fields=$(tac "$JOURNAL" 2>/dev/null | jq -r --argjson id "$id" '
                fromjson? // empty | select(.id == $id) | [.ts, .app, .summary] | @tsv
            ' 2>/dev/null | head -1)
            if [[ -n $fields ]]; then
                IFS=$'\t' read -r ts app summary <<< "$fields"
            else
                # Journal miss (daemon was down at arrival) — fetch from live.
                local live_entry
                live_entry=$(_notif_list_raw \
                    | jq -c --argjson id "$id" '.[] | select(.id == $id)')
                ts=$(date -Iseconds)
                app=$(echo "$live_entry" | jq -r '.app // "?"')
                summary=$(echo "$live_entry" | jq -r '.summary // ""')
            fi
            local crit=0
            (( urgency == 2 )) && crit=1
            # Direct printf to stdout — preserves the \0icon\x1f<name>
            # row metadata that format_rofi_entry appends (NULs are stripped
            # by $() command substitution, so we emit directly).
            format_rofi_entry "$ts" "$app" "$summary" "$urgency" 1 "$crit"
            printf '\n'
        done <<< "$live_map"
    fi

    # History — journal entries NOT in live map. Two-pass so we can emit the
    # "History (N)" header before the rows when N > 0, without buffering
    # NULs through a bash variable (subshell capture strips them).
    if [[ -s $JOURNAL ]]; then
        local -a hist_fields=()
        while IFS= read -r line; do
            [[ -z $line ]] && continue
            local fields id urgency ts app summary
            fields=$(printf '%s' "$line" | jq -r '
                fromjson? // empty
                | [.id, .urgency, .ts, .app, .summary] | @tsv
            ' 2>/dev/null) || continue
            [[ -z $fields ]] && continue
            id="${fields%%$'\t'*}"
            if grep -qE "^${id}"$'\t' <<< "$live_map"; then continue; fi
            hist_fields+=("$fields")
        done < <(tac "$JOURNAL")
        local hist_count=${#hist_fields[@]}
        if (( hist_count > 0 )); then
            format_rofi_header "History ($hist_count)"
            printf '\n'
            local f
            for f in "${hist_fields[@]}"; do
                IFS=$'\t' read -r id urgency ts app summary <<< "$f"
                format_rofi_entry "$ts" "$app" "$summary" "$urgency" 0 0
                printf '\n'
            done
        fi
    fi
}

# ─── Dispatch the user's pick ──────────────────────────────────────────────
handle_pick() {
    local pick="$1"
    # Headers: lines starting with '── '
    if [[ $pick == '── '* ]]; then
        return 0
    fi
    # NOTE: an app literally named "Dismiss all unread" would route here too.
    # Acceptable edge case — the literal pseudo-action wins (intentional).
    if [[ $pick == "Dismiss all unread" ]]; then
        mako_dismiss_all
        return 0
    fi
    # An entry: extract HH:MM and app · summary to find the id in live map.
    # Entry format: "HH:MM  app · summary[ · unread[ · critical]]"
    local body="${pick#*  }"      # strip "HH:MM  "
    # NOTE: if app or summary contains the literal " · unread" or " · critical"
    # substring, this strip can misidentify the boundary. The format-row tags
    # use the same separator as the app · summary split, so any payload
    # containing the tag tokens is ambiguous. Acceptable edge case for P1.
    body="${body% · unread*}"     # strip trailing tags
    body="${body% · critical*}"
    local app="${body%% · *}"
    local summary="${body#* · }"
    # Find a live id by app+summary match (cheapest), or first matching journal id.
    local live_map
    live_map=$(live_unread_map)
    local id=""
    while IFS=$'\t' read -r live_id _; do
        [[ -z $live_id ]] && continue
        local entry
        entry=$(tac "$JOURNAL" 2>/dev/null | jq -c --argjson id "$live_id" '
            fromjson? // empty | select(.id == $id)' 2>/dev/null | head -1)
        local e_app e_sum
        e_app=$(echo "$entry" | jq -r '.app')
        e_sum=$(echo "$entry" | jq -r '.summary')
        if [[ "$e_app" == "$app" && "$e_sum" == "$summary" ]]; then
            id="$live_id"
            break
        fi
    done <<< "$live_map"
    if [[ -n $id ]]; then
        # Fire the app's default action if declared; close the notif either
        # way (mako_invoke already closes on success; dismiss covers the
        # no-default-action case).
        mako_invoke "$id" default >/dev/null 2>&1 || true
        mako_dismiss "$id" >/dev/null 2>&1 || true
    fi
    # Historical pick (no live id match): no-op (rofi closes).
}

# ─── Run ───────────────────────────────────────────────────────────────────
# Pipe build_rows directly to rofi (no $() capture in between) so the
# \0icon\x1f<app_name> row metadata reaches rofi intact.
pick=$(build_rows | rofi -no-config -dmenu -i -p "notifications" -no-custom -show-icons -theme-str '
  configuration { font: "meslo-ng 13"; show-icons: true; }
  window { width: 50%; }
  element-text { padding: 4px 10px; }
  element-icon { size: 1.4em; padding: 0 6px 0 0; }
' 2>/dev/null) || exit 0
handle_pick "$pick"
