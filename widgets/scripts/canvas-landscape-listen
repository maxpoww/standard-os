#!/usr/bin/env bash
# Eww deflisten source for the Landscape section.
# Emits a JSON map of {wsN: "<bare path>" or ""} on every manifest change.
#
# History: the prior version appended a "?t=mtime" cache-buster to each
# path. GTK's image loader treats the query string as part of the
# filename, so every cell with a real snapshot failed to open (eww logs:
# "Failed to open file '/tmp/.../ws-1.png?t=...'") and fell through to
# the empty-placeholder underlay. All 9 cells looked the same. Bare
# paths now; the deflisten still re-emits on manifest change, which is
# how the image widget learns to refresh.

set -u

CACHE=/tmp/standardos/landscape
mkdir -p "$CACHE"

emit() {
    local out='{'
    local first=1 f n
    for n in 1 2 3 4 5 6 7 8 9; do
        f="$CACHE/ws-$n.png"
        [ $first -eq 0 ] && out+=','
        if [ -r "$f" ]; then
            out+="\"ws$n\":\"$f\""
        else
            out+="\"ws$n\":\"\""
        fi
        first=0
    done
    echo "${out}}"
}

# Emit initial state immediately so eww has data on launch.
emit

# Watch the cache dir; only re-emit when manifest.json changes (the daemon
# rewrites it atomically after every successful capture).
inotifywait -m -e close_write,moved_to --format '%f' "$CACHE" 2>/dev/null \
| while read -r name; do
    [ "$name" = "manifest.json" ] && emit
done
