#!/usr/bin/env bash
# Eww deflisten source for the Landscape section.
# Emits a JSON map of {wsN: "<bare path>"} on every manifest change.
#
# History:
#  - v1 appended a "?t=mtime" cache-buster. GTK image loader treats the
#    query as part of the filename, so every real snapshot failed to
#    open. Bare paths now; the deflisten re-emits on manifest change,
#    which is how the image widget learns to refresh.
#  - v2 emitted "" for missing snapshots. eww's image widget then tried
#    to open "" every redraw, emitting `Failed to open file ""` errors
#    at ~90/sec (9 cells × ~10 ticks). After a few seconds the eww UI
#    thread was wedged processing the error queue — `eww close
#    dashboard` would time out, trapping the user in the canvas. v3 (this
#    file) emits a known-good placeholder SVG path for missing
#    snapshots so the image widget always has a valid file to open.
#    The .ls-empty underlay still shows through visually because the
#    placeholder is transparent.

set -u

CACHE=/tmp/standardos/landscape
PLACEHOLDER=/etc/nixos/home/widgets/svg/_blank.svg
mkdir -p "$CACHE"

emit() {
    local out='{'
    local first=1 f n path
    for n in 1 2 3 4 5 6 7 8 9; do
        f="$CACHE/ws-$n.png"
        if [ -r "$f" ]; then
            path="$f"
        else
            path="$PLACEHOLDER"
        fi
        [ $first -eq 0 ] && out+=','
        out+="\"ws$n\":\"$path\""
        first=0
    done
    echo "${out}}"
}

# Emit initial state immediately so eww has data on launch.
emit

# Watch the cache dir; only re-emit when manifest.json changes (the daemon
# rewrites it atomically after every successful capture).
inotifywait -m -e close_write,moved_to --format '%f' "$CACHE" 2>/dev/null \
| while read -r name; do
    [ "$name" = "manifest.json" ] && emit
done
