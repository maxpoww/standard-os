;; ─────────────────────────────────────────────────────────────────────
;;  StandardOS widget canvas — Eww root.
;;
;;  Fullscreen overlay opened via Super+RETURN. Top-level layout:
;;    section-nav  — 15-pill router strip (only `max` is built today;
;;                   the rest render section-placeholder "Coming soon").
;;    section-max  — v31 Max section: user-row (CONFIG | USER-MEGA |
;;                   CALENDAR | EVENTS) over a charts row over a
;;                   bottom row (POMODORO | TODO | NOTES | NOTIF).
;; ─────────────────────────────────────────────────────────────────────

;; ── Data sources ──

;; Time + date.
(defpoll time
  :interval "1s"
  :initial "--:--"
  `date +'%H:%M'`)

(defpoll today
  :interval "60s"
  :initial "—"
  `date +'%A, %B %-d'`)

;; Canvas Apply flow -- staged prefs read from the user-owned JSON file.
;; Empty object when nothing is staged; { shell, groups, groups_display, ... }
;; otherwise. See docs/superpowers/specs/2026-06-25-canvas-prefs-apply-design.md.
(defpoll staged-prefs :interval "1s" :initial "{}"
  `cat $HOME/.config/standardos/staged-prefs.json 2>/dev/null || echo "{}"`)

(defpoll notes-preview
  :interval "5s"
  :initial "Notes file not yet created.\nWrite to ~/.config/standardos/notes.md"
  `tail -n 8 ~/.config/standardos/notes.md 2>/dev/null || echo 'Notes file not yet created.\nWrite to ~/.config/standardos/notes.md'`)

;; Card-cap: dashboard shows only the first 4 entries (mockup density);
;; full list lives in the rofi browser triggered from the bell pill.
(defpoll notif-count :interval "5s" :initial "0"
  `jq -r '.count // 0' /tmp/waybar-cache/notif-history.json 2>/dev/null || echo 0`)
(defpoll notif-entries :interval "5s" :initial "[]"
  `jq -c '.entries[0:4] // []' /tmp/waybar-cache/notif-history.json 2>/dev/null || echo "[]"`)

;; User identity. Avatar falls back to _blank.svg when
;; ~/.config/standardos/avatar.png is missing — the overlay fallback
;; (gradient + person glyph) shows through in that case. Drop a square
;; PNG at ~/.config/standardos/avatar.png to populate.
(defpoll user-name :interval "1h" :initial "user"
  `whoami`)
(defpoll user-fullname :interval "1h" :initial ""
  `getent passwd "$(whoami)" 2>/dev/null | cut -d: -f5 | cut -d, -f1 | head -1`)
(defpoll user-avatar-path :interval "30s" :initial "/etc/nixos/home/widgets/svg/_blank.svg"
  `if [ -r "$HOME/.config/standardos/avatar.png" ]; then echo "$HOME/.config/standardos/avatar.png"; else echo /etc/nixos/home/widgets/svg/_blank.svg; fi`)

;; Active section — drives the canvas section-router. Click any
;; section-pill in section-nav to switch. Default "max" so the canvas
;; lands on the personal-dashboard page. Section ids follow the v31
;; mockup vocabulary; see waybar/docs/mockups/README.md.
(defvar current-section "max")

;; ── v31 Max section data sources ──
;;
;; Calendar grid: {"rows":[[...7 cells...] × 6]}, Monday-first. Each cell
;; is {d, k} where k is "today" / "muted" / "" / (future) "has" when the
;; day carries an agenda event. canvas-cal.sh recomputes once per minute
;; — only the today marker moves at midnight, every other cell is static
;; for the month.
(defpoll cal-grid :interval "1h" :initial '{"rows":[]}'
  `/etc/nixos/home/widgets/scripts/canvas-cal.sh 2>/dev/null || echo '{"rows":[]}'`)

;; Calendar header — month + year line above the grid.
(defpoll cal-header :interval "1h" :initial "—"
  `date +'%b %Y' | tr '[:upper:]' '[:lower:]'`)

;; User-shell + groups — pulled from getent so they reflect actual
;; account state. Refresh hourly; these never change in a session.
(defpoll user-shell :interval "1h" :initial "bash"
  `getent passwd "$(whoami)" 2>/dev/null | cut -d: -f7 | xargs -r basename || echo bash`)
(defpoll user-groups :interval "1h" :initial "—"
  `id -nG "$(whoami)" 2>/dev/null | tr ' ' '\n' | paste -sd' · ' - || echo —`)
(defpoll user-home :interval "1h" :initial "/"
  `getent passwd "$(whoami)" 2>/dev/null | cut -d: -f6 || echo /`)
(defpoll user-last-login :interval "5m" :initial "—"
  `last -n 1 "$(whoami)" 2>/dev/null | head -1 | awk '{print $4, $5, $6, $7}' | sed 's/^ *//' || echo —`)
(defpoll user-uptime-short :interval "30s" :initial "—"
  `awk '{ s=$1; h=int(s/3600); m=int((s%3600)/60); printf "%dh %dm\n", h, m }' /proc/uptime`)

;; v31 charts mock data — these slots stay populated until usage-tracker.sh
;; ships in a later wave. {items:[{name,marker,hrs,pct}], total} shape is
;; what the charts-card widgets render.
(defvar most-used-apps-mock '{"items":[
  {"name":"kitty","marker":"󰄛","hrs":"2h 22m","pct":"41%","width":100,"standout":true},
  {"name":"firefox","marker":"󰈹","hrs":"1h 32m","pct":"27%","width":65,"standout":false},
  {"name":"code","marker":"󰨞","hrs":"1h 00m","pct":"17%","width":42,"standout":false},
  {"name":"chromium","marker":"󰊯","hrs":"28m","pct":"8%","width":20,"standout":false},
  {"name":"nautilus","marker":"","hrs":"18m","pct":"5%","width":13,"standout":false}
],"total":"5h 47m"}')

(defvar weekly-usage-mock '{"items":[
  {"name":"Today","marker":"◆","hrs":"8h 12m","pct":"15%","width":80,"standout":true},
  {"name":"Mon","marker":"·","hrs":"7h 50m","pct":"14%","width":76,"standout":false},
  {"name":"Wed","marker":"·","hrs":"9h 00m","pct":"16%","width":88,"standout":false},
  {"name":"Thu","marker":"·","hrs":"10h 12m","pct":"18%","width":100,"standout":false},
  {"name":"Fri","marker":"·","hrs":"7h 12m","pct":"13%","width":71,"standout":false},
  {"name":"Sat","marker":"·","hrs":"4h 50m","pct":"9%","width":47,"standout":false},
  {"name":"Sun","marker":"·","hrs":"8h 48m","pct":"15%","width":86,"standout":false}
],"total":"56h 04m"}')

(defvar lifetime-usage-mock '{"total":"1,420h","sub":"Since 2024-08-12 · avg 64h / month"}')

;; v31 TODO mock data — wired to a real list once a todo-daemon exists.
(defvar todo-mock '{"items":[
  {"text":"Wire pref clicks","done":false},
  {"text":"Build Resources section","done":false},
  {"text":"Build usage-tracker.sh","done":false},
  {"text":"Per-app notif config UI","done":false},
  {"text":"Light-mode SCSS pass","done":false},
  {"text":"Ship User charts v12","done":true},
  {"text":"Charts in canvas mock","done":true}
]}')

;; Agenda — driven by cal-source-daemon (Wave 3 Task 7). Consumed by
;; max-events-card in section-max.
(defpoll agenda-events :interval "30s" :initial "[]"
  `jq -c '.events // []' /tmp/waybar-cache/agenda.json 2>/dev/null || echo "[]"`)

;; Pomodoro — driven by pomodoro-daemon (Wave 3 Task 5). Consumed by
;; max-pomodoro-card in section-max.
(defpoll pom-state    :interval "1s" :initial "idle"
  `jq -r '.state // "idle"' /tmp/waybar-cache/pomodoro.json 2>/dev/null || echo idle`)
(defpoll pom-text     :interval "1s" :initial "—:—"
  `jq -r '.remaining_text // "—:—"' /tmp/waybar-cache/pomodoro.json 2>/dev/null || echo "—:—"`)
(defpoll pom-done     :interval "5s" :initial "0"
  `jq -r '.blocks_completed_today // 0' /tmp/waybar-cache/pomodoro.json 2>/dev/null || echo 0`)
(defpoll pom-target   :interval "60s" :initial "4"
  `jq -r '.blocks_target // 4' /tmp/waybar-cache/pomodoro.json 2>/dev/null || echo 4`)

;; ── Widgets ──

(defwidget section-pill [id label]
  (eventbox :onclick "eww update current-section=${id}"
    (box :class {current-section == id ? "opt-pill section-pill section-pill-active" : "opt-pill section-pill"}
         :orientation "horizontal" :space-evenly false
      (label :class "section-pill-label" :text label))))

(defwidget section-nav []
  (box :class "section-nav" :orientation "horizontal" :space-evenly false :spacing 2 :halign "center"
    (section-pill :id "max"      :label "Max")
    (section-pill :id "network"  :label "Network and Internet")
    (section-pill :id "devices"  :label "Connected devices")
    (section-pill :id "programs" :label "Programs")
    (section-pill :id "notifs"   :label "Notifications")
    (section-pill :id "sound"    :label "Sound")
    (section-pill :id "modes"    :label "Modes")
    (section-pill :id "display"  :label "Display")
    (section-pill :id "style"    :label "Style and wallpaper")
    (section-pill :id "storage"  :label "Storage")
    (section-pill :id "battery"  :label "Battery")
    (section-pill :id "system"   :label "System")
    (section-pill :id "about"    :label "About this computer")
    (section-pill :id "security" :label "Security and privacy")
    (section-pill :id "location" :label "Location")))

;; USER-MEGA — v31 centered identity card. Avatar + display name +
;; `@user · STDOS` handle + blue Sign out link. No click-to-edit on the
;; card itself, no Lock / Switch-user buttons — those are workflow
;; concerns that don't belong on the user-config surface (v31 freeze
;; 2026-06-24).
(defwidget user-mega-frame []
  (box :class "user-mega" :orientation "vertical"
       :halign "center" :valign "center" :hexpand false
    ;; Inner box holds the four content rows as a group; valign=center +
    ;; vexpand=false centers that group vertically inside the taller
    ;; user-mega card (which has min-height = neighbors' height).
    (box :orientation "vertical" :space-evenly false :spacing 4
         :valign "center" :vexpand false
      (overlay :halign "center"
        (box :class "um-avatar-fallback" :halign "center" :valign "center"
          (label :class "um-avatar-glyph" :text "󰀄"))
        (image :class "um-avatar"
               :path user-avatar-path
               :image-width 64 :image-height 64))
      (label :class "um-name"   :text {user-fullname == "" ? user-name : user-fullname} :halign "center")
      (label :class "um-handle" :text {"@" + user-name + " · STDOS"}                    :halign "center")
      (eventbox :class "um-signout-click" :halign "center"
                :onclick "notify-send 'StandardOS' 'Sign out (coming soon)'"
        (label :class "um-signout" :text "Sign out")))))

(defwidget pref-row [label value on-click ?pending]
  (eventbox :class "pref-row-click" :onclick on-click
    (box :class "pref-row" :orientation "horizontal" :space-evenly false :hexpand true :spacing 8
      (label :class "pref-label" :text label :halign "start" :hexpand false)
      (label :class {pending == "true" ? "pref-value pref-value-pending" : "pref-value"}
             :text value :halign "end" :hexpand true :limit-width 32 :truncate true)
      (label :class "pref-chev"  :text ">"   :halign "end"))))

(defwidget max-config-card []
  (box :class "max-card max-config" :orientation "vertical" :space-evenly false :spacing 4
       :hexpand true :vexpand false
    (label :class "max-sec-label" :text "PROFILE" :halign "start")
    (pref-row :label "Display name" :value {user-fullname == "" ? user-name : user-fullname}
              :on-click "notify-send 'StandardOS' 'Edit display name (coming soon)'")
    (pref-row :label "Password"     :value "set"
              :on-click "notify-send 'StandardOS' 'Change password (coming soon)'")
    (pref-row :label "Fingerprint"  :value "not enrolled"
              :on-click "notify-send 'StandardOS' 'Enroll fingerprint (coming soon)'")
    (pref-row :label "Two-factor"   :value "off"
              :on-click "notify-send 'StandardOS' 'Two-factor auth (coming soon)'")
    (label :class "max-sec-label" :text "ACCOUNT" :halign "start")
    (pref-row :label "Username"       :value user-name
              :on-click "notify-send 'StandardOS' 'Username is set at install time'")
    (pref-row :label "Default shell"
              :value   {staged-prefs.shell != "" ? staged-prefs.shell : user-shell}
              :pending {staged-prefs.shell != "" ? "true" : "false"}
              :on-click "/etc/nixos/home/scripts/pref-choose-shell")
    (pref-row :label "Groups"
              :value   {staged-prefs.groups_display != "" ? staged-prefs.groups_display : user-groups}
              :pending {staged-prefs.groups_display != "" ? "true" : "false"}
              :on-click "/etc/nixos/home/scripts/pref-choose-groups")
    (pref-row :label "Home directory" :value user-home
              :on-click "notify-send 'StandardOS' 'Home directory'")
    (pref-row :label "Last login"     :value user-last-login
              :on-click "notify-send 'StandardOS' 'Login history'")
    (pref-row :label "Uptime"         :value user-uptime-short
              :on-click "true")))

;; Calendar day cell — one box in the 7x6 grid. Cell shape from canvas-cal.sh.
(defwidget max-cal-day [d k]
  (box :class {"max-cal-day max-cal-day-" + (k == "" ? "norm" : k)}
       :halign "fill" :valign "fill"
    (label :text d :halign "center" :valign "center")))

(defwidget max-cal-row [cells]
  (box :orientation "horizontal" :space-evenly true :spacing 2 :hexpand true
    (for c in {cells}
      (max-cal-day :d {c.d} :k {c.k}))))

;; CALENDAR: month + year label, weekday header, 6-row grid.
;; The 6 rows are sliced from cal-grid-cells via array index ranges so each
;; row gets 7 cells. cal-grid-cells is the flat 42-element JSON array.
(defwidget max-cal-card []
  (box :class "max-card max-cal" :orientation "vertical" :space-evenly false :spacing 4
       :hexpand true :vexpand false
    (label :class "max-sec-label" :text {"CALENDAR · " + cal-header} :halign "start")
    (box :class "max-cal-head" :orientation "horizontal" :space-evenly true :spacing 2 :hexpand true
      (label :text "M") (label :text "T") (label :text "W") (label :text "T")
      (label :text "F") (label :text "S") (label :text "S"))
    (for row in {cal-grid.rows}
      (max-cal-row :cells {row}))))

;; EVENTS card: Today list (minutes_until < 1440) and Tomorrow list
;; (1440 <= minutes_until < 2880), both from agenda-events.
(defwidget max-event-row [summary start-text]
  (box :class "max-event" :orientation "horizontal" :space-evenly false :hexpand true
    (label :class "max-event-name" :text summary    :halign "start" :hexpand true)
    (label :class "max-event-when" :text start-text :halign "end")))

(defwidget max-events-card []
  (box :class "max-card max-events" :orientation "vertical" :space-evenly false :spacing 4
       :hexpand true :vexpand false
    (label :class "max-sec-label" :text "EVENTS · TODAY" :halign "start")
    (box :class "max-events-list" :orientation "vertical" :space-evenly false :spacing 2
      (for e in {agenda-events}
        (box :visible {e.minutes_until < 1440} :orientation "horizontal" :hexpand true
          (max-event-row :summary {e.summary} :start-text {e.start_text}))))
    (label :class "max-sec-label" :text "TOMORROW" :halign "start")
    (box :class "max-events-list" :orientation "vertical" :space-evenly false :spacing 2
      (for e in {agenda-events}
        (box :visible {e.minutes_until >= 1440 && e.minutes_until < 2880}
             :orientation "horizontal" :hexpand true
          (max-event-row :summary {e.summary} :start-text {e.start_text}))))))

;; CHARTS row: bar-list with standout (violet) on row 1 of each chart.
;; Mock data lives in most-used-apps-mock + weekly-usage-mock (defvars
;; above); flip to a real JSON poll once usage-tracker.sh ships.
(defwidget max-bar-row [marker name hrs pct width standout]
  (box :class {standout == "true" ? "max-bar standout" : "max-bar"}
       :orientation "horizontal" :space-evenly false :spacing 6 :hexpand true
    (label :class "max-bar-marker" :text marker)
    (label :class "max-bar-name"   :text name   :halign "start")
    (overlay
      (box :class "max-bar-track" :hexpand true
        (box :class "max-bar-fill" :hexpand false
             :style "min-width: ${width}%;")
        (box :hexpand true))
      (box :hexpand true))
    (label :class "max-bar-hrs"    :text hrs)
    (label :class "max-bar-pct"    :text pct)))

;; Chart card pieces shared by max-chart-most-used / lifetime / weekly.
(defwidget max-chart-header [title value sub]
  (box :orientation "vertical" :space-evenly false :spacing 0
    (box :orientation "horizontal" :space-evenly false :hexpand true
      (label :class "max-chart-label" :text title :halign "start" :hexpand true)
      (label :class "max-chart-value" :text value :halign "end"))
    (label :class "max-chart-sub" :text sub :halign "start")))

(defwidget max-chart-bar-list [items]
  (box :class "max-chart-list" :orientation "vertical" :space-evenly false :spacing 2
    (for it in {items}
      (max-bar-row :marker {it.marker} :name {it.name} :hrs {it.hrs}
                   :pct {it.pct} :width {it.width}
                   :standout {it.standout ? "true" : "false"}))))

(defwidget max-chart-most-used []
  (box :class "max-card max-chart" :orientation "vertical" :space-evenly false :spacing 4
       :hexpand true :vexpand true
    (max-chart-header :title "MOST USED APPS" :value {most-used-apps-mock.total}
                      :sub "focus time · top one bolder")
    (max-chart-bar-list :items {most-used-apps-mock.items})))

;; GTK gap: the v31 mockup shows an area chart here. Eww/GTK CSS does
;; not paint cubic-bezier line art the same way the browser does; until
;; a curve-rendering script ships, show a textual placeholder.
(defwidget max-chart-lifetime []
  (box :class "max-card max-chart" :orientation "vertical" :space-evenly false :spacing 4
       :hexpand true :vexpand true
    (max-chart-header :title "LIFETIME USAGE" :value {lifetime-usage-mock.total}
                      :sub {lifetime-usage-mock.sub})
    (box :class "max-chart-placeholder" :valign "center" :halign "center" :vexpand true
      (label :class "max-chart-empty" :text "area chart wires to usage-tracker.sh"))))

(defwidget max-chart-weekly []
  (box :class "max-card max-chart" :orientation "vertical" :space-evenly false :spacing 4
       :hexpand true :vexpand true
    (max-chart-header :title "WEEKLY USAGE" :value {weekly-usage-mock.total}
                      :sub "Mon - Sun · today bolder")
    (max-chart-bar-list :items {weekly-usage-mock.items})))

;; POMODORO: focus state badge + transport + dots + settings.
(defwidget max-pomo-dot [n]
  (label :class {n * 1 <= pom-done * 1 ? "max-pomo-dot done" : "max-pomo-dot"} :text " "))

(defwidget max-pomodoro-card []
  (box :class "max-card max-pomo" :orientation "vertical" :space-evenly false :spacing 4
       :hexpand true :vexpand true
    (label :class "max-chart-label" :text "POMODORO" :halign "start")
    (box :class "max-pomo-badge-row" :halign "start" :hexpand true
      (label :class {"max-pomo-badge max-pomo-badge-" + pom-state}
             :text {"FOCUS · " + pom-text + " left"}))
    (box :class "max-pomo-ctrls" :orientation "horizontal" :space-evenly true :halign "fill"
      (button :class "max-pomo-btn primary" :onclick "/etc/nixos/home/scripts/pomodoroctl start" "PAUSE")
      (button :class "max-pomo-btn"         :onclick "/etc/nixos/home/scripts/pomodoroctl skip"  "SKIP")
      (button :class "max-pomo-btn"         :onclick "/etc/nixos/home/scripts/pomodoroctl stop"  "STOP"))
    (box :class "max-pomo-dots" :orientation "horizontal" :space-evenly false :spacing 4 :halign "start"
      (label :class "max-pomo-blocks-text" :text {pom-done + " / " + pom-target + " blocks"} :halign "start")
      (max-pomo-dot :n "1") (max-pomo-dot :n "2") (max-pomo-dot :n "3") (max-pomo-dot :n "4")
      (max-pomo-dot :n "5") (max-pomo-dot :n "6") (max-pomo-dot :n "7") (max-pomo-dot :n "8"))
    (pref-row :label "Target"      :value pom-target
              :on-click "notify-send 'StandardOS' 'Pomodoro target (coming soon)'")
    (pref-row :label "Work"        :value "25 min"
              :on-click "notify-send 'StandardOS' 'Pomodoro work length (coming soon)'")
    (pref-row :label "Short break" :value "5 min"
              :on-click "notify-send 'StandardOS' 'Pomodoro short break (coming soon)'")
    (pref-row :label "Long break"  :value "15 min"
              :on-click "notify-send 'StandardOS' 'Pomodoro long break (coming soon)'")))

;; TODO card: checklist rendered from todo-mock. Done items get the
;; line-through treatment; checkboxes are pure visual marks (no toggle yet).
(defwidget max-todo-row [text done]
  (box :class {done == "true" ? "max-todo-row done" : "max-todo-row"}
       :orientation "horizontal" :space-evenly false :spacing 6 :hexpand true
    (label :class {done == "true" ? "max-todo-chk checked" : "max-todo-chk"} :text " ")
    (label :class "max-todo-text" :text text :halign "start" :hexpand true :wrap true :limit-width 28)))

(defwidget max-todo-card []
  (box :class "max-card max-todo" :orientation "vertical" :space-evenly false :spacing 4
       :hexpand true :vexpand true
    (label :class "max-sec-label" :text "TODO" :halign "start")
    (box :class "max-todo-list" :orientation "vertical" :space-evenly false :spacing 2
      (for it in {todo-mock.items}
        (max-todo-row :text {it.text} :done {it.done ? "true" : "false"})))))

;; NOTES card: existing notes-preview poll, formatted v31-style.
(defwidget max-notes-card []
  (box :class "max-card max-notes" :orientation "vertical" :space-evenly false :spacing 4
       :hexpand true :vexpand true
    (label :class "max-sec-label" :text "NOTES · RECENT" :halign "start")
    (label :class "max-notes-body" :text notes-preview :wrap true :limit-width 28
           :halign "start" :valign "start" :vexpand true)))

;; NOTIF HISTORY card: reuses the existing field-notif-row visual.
(defwidget max-notif-card []
  (box :class "max-card max-notif" :orientation "vertical" :space-evenly false :spacing 4
       :hexpand true :vexpand true
    (label :class "max-sec-label" :text {"NOTIFICATIONS · " + notif-count} :halign "start")
    (box :class "max-notif-list" :orientation "vertical" :space-evenly false :spacing 2 :vexpand true
      (for entry in {notif-entries}
        (box :class "max-notif-row" :orientation "horizontal" :space-evenly false :spacing 6 :hexpand true
          (label :class "max-notif-app"   :text {entry.app}     :halign "start")
          (label :class "max-notif-title" :text {entry.summary} :halign "start" :hexpand true :wrap true :limit-width 24))))))

;; The full Max section composes the three rows. Row roles:
;;   USER LINE  — content-driven (no :vexpand), holds at ~CONFIG-card height.
;;   CHARTS row — :vexpand true, claims the remaining vertical middle space.
;;   BOTTOM row — content-driven (no :vexpand), capped at .max-bottom-row min/max in SCSS.
;; Without these roles the BOTTOM row over-claims space (its cards have few
;; rows so they end up with a tall empty bottom strip), and USER ends up
;; visually heavier than the mockup intends.
(defwidget section-max []
  (box :class "section section-max" :orientation "vertical" :space-evenly false :spacing 7
       :halign "fill" :valign "fill" :hexpand true :vexpand true
    ;; USER LINE — centerbox layout. USER-MEGA sits at the exact geometric
    ;; center of the row; max-config fills the left half, max-cal +
    ;; max-events fill the right half. centerbox guarantees center
    ;; placement regardless of side-child widths.
    (centerbox :class "max-user-row" :orientation "horizontal"
      (box :class "max-user-left" :orientation "horizontal" :spacing 7
           :hexpand true :halign "fill"
        (max-config-card))
      (user-mega-frame)
      (box :class "max-user-right" :orientation "horizontal" :spacing 7
           :hexpand true :halign "fill"
        (max-cal-card)
        (max-events-card)))
    ;; CHARTS row — explicit min-height (roughly half of what vexpand
    ;; would have claimed); the freed slack flows into bottom-row.
    (box :class "max-charts-row" :orientation "horizontal" :space-evenly false :spacing 7
         :halign "fill" :hexpand true :vexpand false
      (max-chart-most-used)
      (max-chart-lifetime)
      (max-chart-weekly))
    ;; BOTTOM row — claims all the vertical slack the charts row gave up.
    (box :class "max-bottom-row" :orientation "horizontal" :space-evenly false :spacing 7
         :halign "fill" :hexpand true :vexpand true
      (max-pomodoro-card)
      (max-todo-card)
      (max-notes-card)
      (max-notif-card))))

;; Generic placeholder for sections we haven't built yet.
(defwidget section-placeholder [name]
  (box :class "section section-placeholder" :orientation "vertical" :space-evenly false :spacing 6
       :halign "center" :valign "center" :vexpand true
    (label :class "section-placeholder-label" :text name)
    (label :class "section-placeholder-sub"   :text "Coming soon")))

;; Section router slot — common wrapper around each not-yet-built
;; section's placeholder. The "max" section uses an inline (box ...
;; (section-max)) call instead because it has a real body, not a name.
(defwidget section-slot [id name]
  (box :visible {current-section == id} :orientation "vertical"
       :hexpand true :vexpand true :halign "fill" :valign "fill"
    (section-placeholder :name name)))

;; ── Canvas root ──
;;
;; Wrapped in an overlay so a small × close button can float in the
;; top-right corner. The button is a recovery affordance for the Esc
;; binding (the canonical close mechanism) — if the user ever finds
;; themselves with the canvas open and no working keyboard path,
;; the button is the guaranteed escape. Click target is the same
;; canvas-close script the Esc bind invokes.

(defwidget canvas []
  (overlay
    (box :class "canvas-root"
         :orientation "vertical"
         :space-evenly false
         :spacing 7
      (section-nav)
      (box :class "section-body" :orientation "vertical" :space-evenly false
           :hexpand true :vexpand true :halign "fill" :valign "fill"
        (box :visible {current-section == "max"} :orientation "vertical"
             :hexpand true :vexpand true :halign "fill" :valign "fill"
          (section-max))
        (section-slot :id "network"  :name "Network and Internet")
        (section-slot :id "devices"  :name "Connected devices")
        (section-slot :id "programs" :name "Programs")
        (section-slot :id "notifs"   :name "Notifications")
        (section-slot :id "sound"    :name "Sound")
        (section-slot :id "modes"    :name "Modes")
        (section-slot :id "display"  :name "Display")
        (section-slot :id "style"    :name "Style and wallpaper")
        (section-slot :id "storage"  :name "Storage")
        (section-slot :id "battery"  :name "Battery")
        (section-slot :id "system"   :name "System")
        (section-slot :id "about"    :name "About this computer")
        (section-slot :id "security" :name "Security and privacy")
        (section-slot :id "location" :name "Location")))
    (box :class "canvas-close-wrap" :halign "end" :valign "start" :hexpand false :vexpand false
      (button :class "canvas-close"
              :tooltip "Dismiss (Esc)"
              :onclick "/etc/nixos/home/scripts/canvas-close"
        "✕"))))

;; ── Window ──

;; Geometry: anchor "center" leaves no edge anchored, so the layer
;; surface ignores other layers' exclusive zones (waybar) and gets
;; the full monitor as its size. width/height "100%" then expand to
;; the monitor extent. Result: canvas covers everything including
;; the bar area without touching the waybar.
(defwindow dashboard
  :monitor 0
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "100%" :anchor "center")
  :stacking "overlay"
  :exclusive false
  :focusable true
  (canvas))
