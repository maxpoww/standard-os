#!/usr/bin/env bash
# canvas-open — open the StandardOS Dashboard fullscreen. Wired to
# Super+RETURN via hypr/modules/Binds.conf.
#
# Passes the focused monitor's logical pixel size via --size, because
# eww's geometry "100%" computes against the workarea (below the
# waybar) and falls short of the full monitor by the bar's height.
# The defwindow keeps anchor "center" so Hyprland does not apply the
# bar's exclusive-zone offset — combined, the canvas covers the full
# monitor over the bar natively.

set -uo pipefail

source /etc/nixos/home/scripts/lib/canvas-anchor.sh
read -r _x _y w h < <(canvas_geometry_for_open)

# Wake the landscape snapshot daemon so the current workspace's cell
# refreshes the moment the canvas appears. Silent no-op if the cache
# dir does not exist (daemon disabled).
mkdir -p /tmp/standardos/landscape && touch /tmp/standardos/landscape/open-trigger

exec eww open dashboard --size "${w}x${h}"
