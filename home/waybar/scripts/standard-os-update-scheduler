#!/usr/bin/env bash
# standard-os-update-scheduler — fires from a user-systemd timer every
# 5 minutes AND from the post-commit git hook. Decides whether to run
# the UPDATE pipeline:
#
#   1. Detection: is anything pending? (source-ahead, boot-diverged in L1;
#      channel-ahead, GC-overdue, optimise-overdue, CVE in L2–L5)
#   2. Lock check: is a pipeline already running?
#   3. Spawn the pipeline detached via systemd-run --user --scope.
#
# No idle gating: a rebuild that's pending should land in current-system
# as soon as possible, not wait for the user to look away. The pipeline
# itself runs through passwordless pkexec and surfaces via the updating
# pill (passive feedback) plus the eventual power-pill reboot face. The
# 5-min timer is a safety net for commits whose hook didn't fire (e.g.,
# checkout-as-commit, out-of-band ref moves).
#
# Library mode (STANDARD_OS_UPDATE_SCHEDULER_LIB_ONLY=1) skips main body.
set -uo pipefail

SELF_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# shellcheck source=lib/pill.sh
. "$SELF_DIR/lib/pill.sh"

LOCK_FILE="/run/standard-os/update.lock"
PIPELINE_BIN="${PIPELINE_BIN:-standard-os-update}"

# ─── Detection (L1 conditions only) ───────────────────────────────────────
is_source_ahead() {
    [ -f /run/standard-os/activated-commit ] || return 1
    local activated head
    activated=$(cat /run/standard-os/activated-commit 2>/dev/null) || return 1
    head=$(git -C /etc/nixos rev-parse HEAD 2>/dev/null) || return 1
    [ "$activated" != "$head" ]
}

# Anything pending → returns 0. L2–L5 add more conditions here.
detection_any_pending() {
    is_source_ahead && return 0
    return 1
}

# ─── Main dispatch ────────────────────────────────────────────────────────
# Idle gating was removed: the user wants the rebuild as soon as possible
# after a commit, no fullscreen / input-idle / DND wait. The pipeline's
# polkit rule is passwordless, the pkexec call is non-interactive, and
# the only user-visible artifact is the updating-pill (passive feedback)
# plus the eventual power-pill swap to its reboot face when activation
# succeeds. Concurrent runs are still prevented by the lock-file check.
schedule() {
    detection_any_pending || return 0
    if [ -e "$LOCK_FILE" ] && fuser "$LOCK_FILE" >/dev/null 2>&1; then
        return 0
    fi
    systemd-run --user --scope --unit="standard-os-update-run-$(date +%s)" \
        "$PIPELINE_BIN" >/dev/null 2>&1 &
    return 0
}

[ "${STANDARD_OS_UPDATE_SCHEDULER_LIB_ONLY:-0}" = "1" ] && return 0
schedule
exit 0
